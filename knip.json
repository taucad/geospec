{
  "$schema": "./node_modules/knip/schema.json",
  "treatConfigHintsAsErrors": true,
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/**/*.test.mjs", "tools/nx/*.mjs", "*.config.ts", "*.test.ts"],
      "ignoreDependencies": ["@nx/js", "playwright"]
    },
    "packages/geospec-engine": {
      "entry": [
        "bench/run.ts",
        "bench/worker.ts",
        "bench/{lib,broad-harness,broad-fixtures,measurements}.test.ts",
        "bench/vitest-consumer{.config,-event}.mjs",
        "bench/performance-lab.ts",
        "bindings/browser-conformance/run-browser-conformance.ts",
        "bindings/browser-conformance/app/run.ts",
        "bindings/browser-conformance/{run-node26-conformance.ts,conformance.vitest.mjs}",
        "bindings/browser-conformance/{qualify-mt-product,mt-browser-worker,mt-node-worker}.mjs",
        "scripts/{build-mixed-wasm,prepare-legacy-reference}.mts",
        "scripts/{ci-artifacts,ci-artifacts.test,ci-products}.mjs",
        "trust/{canonicalize,evaluate-worker,demo,self-check}.mjs",
        "trust/type-consumer.ts",
        "vitest.node26.config.ts"
      ],
      "ignore": ["bench/fixtures/performance-lab/workspace/**", "host-tests/**"],
      "ignoreUnresolved": ["#native-binding", "#mixed-wasm-binding"],
      "ignoreDependencies": ["@napi-rs/cli"]
    }
  },
  "ignoreBinaries": ["cmp", "lockf", "ps", "python3", "rustup", "strip"]
}
