{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": ["./tools/nx/package-targets.mjs"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "runtime"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.test-d.*",
      "!{projectRoot}/vitest.config.*",
      "!{projectRoot}/**/*.md"
    ],
    "runtime": [
      { "runtime": "node --version" },
      { "runtime": "pnpm --version" },
      { "runtime": "RUSTUP_AUTO_INSTALL=0 rustc --version 2>/dev/null || echo rustc-absent" }
    ]
  },
  "targetDefaults": {
    "build": { "inputs": ["production", "^production"] },
    "test": { "inputs": ["default", "^production"] },
    "typecheck": { "inputs": ["default", "^production"] }
  },
  "release": {
    "projects": ["geospec-engine", "geospec"],
    "projectsRelationship": "fixed",
    "version": {
      "specifierSource": "version-plans",
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "versionPlans": {
      "ignorePatternsForPlanCheck": [
        "**/*.test.*",
        "**/*.md",
        ".gitattributes",
        ".gitignore",
        ".oxfmtrc.json",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "MAINTAINER.md",
        "SECURITY.md",
        "names.json",
        "osv-scanner.toml",
        ".github/**",
        ".vale/**",
        "corpus/**",
        "docs-site/**",
        "scripts/**",
        "tests/**",
        "tools/**"
      ]
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "releaseTag": { "pattern": "v{version}" },
    "git": {
      "commit": false,
      "push": false,
      "stageChanges": false,
      "tag": false
    }
  },
  "analytics": false
}
