{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "geospec-repo",
  "root": ".",
  "targets": {
    "check:dead-code": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run check:dead-code" }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run format:check" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint" }
    },
    "prose": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run prose" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck" }
    },
    "workflows": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run workflows" }
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run docs:build && pnpm run docs:routes && pnpm run docs:test" }
    },
    "docs-e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["docs"],
      "options": { "command": "pnpm run docs:e2e" }
    },
    "qualify-test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test tests/ci/qualify-*.test.mjs" }
    },
    "qualify-gate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/qualify/canonical-equality.mjs --legs out/qualify/legs --out out/qualify/legs/equality/ledger.json && node scripts/qualify/qualification-gate.mjs --legs out/qualify/legs --out out/qualify/summary.json --require-leg plan"
      }
    },
    "docs-prose": {
      "executor": "nx:noop",
      "dependsOn": ["docs", "docs-e2e", "prose"]
    },
    "quality": {
      "executor": "nx:noop",
      "dependsOn": ["check:dead-code", "format", "lint", "prose", "test", "typecheck", "workflows"]
    }
  }
}
