.DS_Store
.ci-tools/
.nx/*
!.nx/version-plans/
!.nx/version-plans/*.md
node_modules/
coverage/
dist/
out/
# Upstream directory names inside the STEP corpus are data, not build output.
!/corpus/step/**/out/
out-tsc/
target/
*.tsbuildinfo
# napi-rs writes platform package directories during release assembly.
packages/*/npm/
# The docs build tessellates the live demo's display mesh from its STEP file.
docs-site/public/demo/*.mesh.json
