{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/docs/:path*.mdx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/docs.mdx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/search",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/guides/choose-a-binding",
      "destination": "/docs/install",
      "permanent": true
    },
    {
      "source": "/docs/guides/test-with-python",
      "destination": "/docs/guides/test-parts-in-ci",
      "permanent": true
    },
    {
      "source": "/docs/python",
      "destination": "/docs/api",
      "permanent": true
    }
  ]
}
