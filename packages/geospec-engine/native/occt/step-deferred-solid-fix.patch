+void STEPControl_ActorRead::SetDeferredFixWorkers(const int theNbWorkers)
+{
+  if (myTransferDepth != 0)
+  {
+    return;
+  }
+  myDeferredFixes          = std::make_shared<STEPControl_ActorReadDeferredFixes>();
+  myDeferredFixes->Workers = std::max(0, std::min(theNbWorkers, 2));
+}
+
+int STEPControl_ActorRead::NbDeferredFixes() const
+{
+  return myDeferredFixes ? myDeferredFixes->NbDeferred : 0;
+}
+
+int STEPControl_ActorRead::NbSharedFixes() const
+{
+  return myDeferredFixes ? myDeferredFixes->NbShared : 0;
+}
+
+int STEPControl_ActorRead::NbReshapedDeferredFixes() const
+{
+  return myDeferredFixes ? myDeferredFixes->NbReshaped : 0;
+}
+
+bool STEPControl_ActorRead::DeferredFixDiverged() const
+{
+  return myDeferredFixes ? myDeferredFixes->Diverged : false;
+}
+
+void STEPControl_ActorRead::SetDeferredFixStandInMismatch(const bool theToMismatch)
+{
+  if (myDeferredFixes && myTransferDepth == 0)
+  {
+    myDeferredFixes->StandInMismatch = theToMismatch;
+  }
+}
