+using DeferredFixes = STEPControl_ActorReadDeferredFixes;
+
+uint16_t shapeFlags(const TopoDS_Shape& theShape)
+{
+  return static_cast<uint16_t>((theShape.Free() ? 1 : 0) | (theShape.Modified() ? 2 : 0)
+                               | (theShape.Checked() ? 4 : 0) | (theShape.Orientable() ? 8 : 0)
+                               | (theShape.Closed() ? 16 : 0) | (theShape.Infinite() ? 32 : 0)
+                               | (theShape.Convex() ? 64 : 0) | (theShape.Locked() ? 128 : 0));
+}
+
+void setShapeFlags(TopoDS_Shape& theShape, const uint16_t theFlags)
+{
+  theShape.Free((theFlags & 1) != 0);
+  theShape.Modified((theFlags & 2) != 0);
+  theShape.Checked((theFlags & 4) != 0);
+  theShape.Orientable((theFlags & 8) != 0);
+  theShape.Closed((theFlags & 16) != 0);
+  theShape.Infinite((theFlags & 32) != 0);
+  theShape.Convex((theFlags & 64) != 0);
+  theShape.Locked((theFlags & 128) != 0);
+}
+
+void workerLoop(DeferredFixes* theFixes)
+{
+  for (;;)
+  {
+    DeferredFixes::Job* aJob = nullptr;
+    {
+      std::unique_lock<std::mutex> aLock(theFixes->Mutex);
+      theFixes->Wake.wait(aLock, [theFixes] { return theFixes->Stop || !theFixes->Queue.empty(); });
+      if (theFixes->Queue.empty())
+      {
+        return;
+      }
+      aJob = theFixes->Queue.front();
+      theFixes->Queue.pop_front();
+    }
+    TopoDS_Shape                           aResult;
+    occ::handle<ShapeProcess_ShapeContext> aContext;
+    bool                                   aFailed = false;
+    try
+    {
+      OCC_CATCH_SIGNALS
+      // The completion computes with the rounding and exception modes it would have in place.
+      std::fesetenv(&aJob->FloatEnvironment);
+      XSAlgo_ShapeProcessor aShapeProcessor(aJob->Parameters);
+      aResult  = aShapeProcessor.ProcessShape(aJob->Source, aJob->Operations, Message_ProgressRange());
+      aContext = aShapeProcessor.GetContext();
+    }
+    catch (...)
+    {
+      aFailed = true;
+    }
+    // The solid before completion and the parameters are not needed any more.
+    aJob->Source.Nullify();
+    aJob->Parameters.Clear();
+    {
+      const std::lock_guard<std::mutex> aLock(theFixes->Mutex);
+      aJob->Result  = aResult;
+      aJob->Context = aContext;
+      aJob->Failed  = aFailed;
+      aJob->Done    = true;
+    }
+    theFixes->Finished.notify_all();
+  }
+}
+
+#if !defined(_WIN32)
+void* workerMain(void* theFixes)
+{
+  workerLoop(static_cast<DeferredFixes*>(theFixes));
+  return nullptr;
+}
+#endif
+
+// Starts one worker with an 8 MiB stack, the size the calling thread usually has
+// (some platforms give new threads 512 KiB). False when none could be started.
+bool startWorker(DeferredFixes& theFixes)
+{
+  try
+  {
+    theFixes.Threads.reserve(theFixes.Threads.size() + 1);
+  }
+  catch (...)
+  {
+    return false;
+  }
+#if defined(_WIN32)
+  try
+  {
+    theFixes.Threads.emplace_back(workerLoop, &theFixes);
+    return true;
+  }
+  catch (...)
+  {
+    return false;
+  }
+#else
+  pthread_attr_t anAttributes;
+  if (pthread_attr_init(&anAttributes) != 0)
+  {
+    return false;
+  }
+  pthread_t  aThread;
+  const bool isStarted = pthread_attr_setstacksize(&anAttributes, size_t(8) << 20) == 0
+                         && pthread_create(&aThread, &anAttributes, workerMain, &theFixes) == 0;
+  pthread_attr_destroy(&anAttributes);
+  if (isStarted)
+  {
+    theFixes.Threads.push_back(aThread); // capacity reserved above: does not throw
+  }
+  return isStarted;
+#endif
+}
+
+// XSAlgo_ShapeProcessor::MergeShapeTransferInfo bounded to one item's own range:
+// the in-place completion merges before the transfer binds anything after that item.
+// Returns how many bound results it replaced.
+int mergeTransferInfoRange(const occ::handle<Transfer_TransientProcess>& theTP,
+                            const occ::handle<ShapeProcess_ShapeContext>& theContext,
+                            const int                                     theFirstTPItem,
+                            const int                                     theLastTPItem)
+{
+  int aNbReplaced = 0;
+  if (theContext.IsNull())
+  {
+    return aNbReplaced;
+  }
+  const NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>& aModified =
+    theContext->Map();
+  const occ::handle<ShapeExtend_MsgRegistrator>& aMessages = theContext->Messages();
+  if (aModified.IsEmpty())
+  {
+    return aNbReplaced;
+  }
+  const bool aToPrint = !aMessages.IsNull() && !aMessages->MapShape().IsEmpty();
+  const int  aLast    = std::min(theLastTPItem, theTP->NbMapped());
+  for (int i = std::max(theFirstTPItem, 1); i <= aLast; ++i)
+  {
+    occ::handle<TransferBRep_ShapeBinder> aShapeBinder =
+      occ::down_cast<TransferBRep_ShapeBinder>(theTP->MapItem(i));
+    if (aShapeBinder.IsNull() || aShapeBinder->Result().IsNull())
+    {
+      continue;
+    }
+    const TopoDS_Shape anOriginalShape = aShapeBinder->Result();
+    if (aModified.IsBound(anOriginalShape))
+    {
+      aShapeBinder->SetResult(aModified.Find(anOriginalShape));
+      ++aNbReplaced;
+    }
+    else if (!anOriginalShape.Location().IsIdentity())
+    {
+      TopLoc_Location aNullLoc;
+      TopoDS_Shape    aTemporaryShape = anOriginalShape.Located(aNullLoc);
+      if (aModified.IsBound(aTemporaryShape))
+      {
+        aShapeBinder->SetResult(aModified.Find(aTemporaryShape));
+        ++aNbReplaced;
+      }
+    }
+    else
+    {
+      BRepTools_ReShape aReShaper;
+      bool              aHasModifiedEdges = false;
+      for (TopExp_Explorer anExpSE(anOriginalShape, TopAbs_EDGE); anExpSE.More(); anExpSE.Next())
+      {
+        if (aModified.IsBound(anExpSE.Current()))
+        {
+          aHasModifiedEdges           = true;
+          TopoDS_Shape aModifiedShape = aModified.Find(anExpSE.Current());
+          aReShaper.Replace(anExpSE.Current(), aModifiedShape);
+        }
+      }
+      if (aHasModifiedEdges)
+      {
+        TopoDS_Shape aReshapedShape = aReShaper.Apply(anOriginalShape);
+        aShapeBinder->SetResult(aReshapedShape);
+        ++aNbReplaced;
+      }
+    }
+    if (aToPrint)
+    {
+      const NCollection_List<Message_Msg>* aShapeMessages =
+        aMessages->MapShape().Seek(anOriginalShape);
+      if (aShapeMessages != nullptr)
+      {
+        for (NCollection_List<Message_Msg>::Iterator aMsgIter(*aShapeMessages); aMsgIter.More();
+             aMsgIter.Next())
+        {
+          const Message_Msg& aMessage = aMsgIter.Value();
+          aShapeBinder->AddWarning(TCollection_AsciiString(aMessage.Value()).ToCString(),
+                                   TCollection_AsciiString(aMessage.Original()).ToCString());
+        }
+      }
+    }
+  }
+  return aNbReplaced;
+}
+
+// Gives the completed solid's children and status flags to the stand-in, which
+// every result of the transfer already holds. Returns false when it cannot.
+bool fillStandIn(DeferredFixes::Job& theJob)
+{
+  const TopoDS_Shape& aResult = theJob.Result;
+  TopoDS_Shape        aStandIn = theJob.StandIn;
+  if (aResult.IsNull() || aResult.ShapeType() != TopAbs_SOLID
+      || aResult.Orientation() != aStandIn.Orientation() || !aResult.Location().IsIdentity()
+      || aResult.TShape()->DynamicType() != aStandIn.TShape()->DynamicType())
+  {
+    return false;
+  }
+  // Only TopoDS_Builder::Add may have touched the stand-in: it freezes a component.
+  const uint16_t aStandInFlags = shapeFlags(aStandIn);
+  if ((aStandInFlags | 1) != (theJob.StandInFlags | 1) || aStandIn.NbChildren() != 0)
+  {
+    return false;
+  }
+  const bool     aFrozen = !aStandIn.Free();
+  const uint16_t aFlags  = static_cast<uint16_t>(shapeFlags(aResult) & ~(aFrozen ? 1 : 0));
+  for (TopoDS_Iterator aChild(aResult, false, false); aChild.More(); aChild.Next())
+  {
+    if (aChild.Value().Free())
+    {
+      return false;
+    }
+  }
+  aStandIn.Free(true);
+  BRep_Builder aBuilder;
+  for (TopoDS_Iterator aChild(aResult, false, false); aChild.More(); aChild.Next())
+  {
+    aBuilder.Add(aStandIn, aChild.Value());
+  }
+  setShapeFlags(aStandIn, aFlags);
+  return true;
+}
+
+void collectEdgeEntities(const occ::handle<StepShape_Edge>&      theEdge,
+                         std::vector<const Standard_Transient*>& theEntities)
+{
+  theEntities.push_back(theEdge.get());
+  for (const occ::handle<StepShape_Vertex>& aVertex : {theEdge->EdgeStart(), theEdge->EdgeEnd()})
+  {
+    if (!aVertex.IsNull())
+    {
+      theEntities.push_back(aVertex.get());
+    }
+  }
+}
+
+// Every entity the translation of this solid may look up in, or bind into, the
+// transfer process, reached the way StepToTopoDS_Builder reaches them, and more.
+// False for a kind this walk does not know.
+bool collectSolidEntities(const occ::handle<StepShape_ManifoldSolidBrep>& theSolid,
+                          std::vector<const Standard_Transient*>&       theEntities)
+{
+  if (theSolid->IsKind(STANDARD_TYPE(StepShape_FacetedBrepAndBrepWithVoids)))
+  {
+    return false; // its voids are not reached through StepShape_BrepWithVoids
+  }
+  NCollection_Sequence<occ::handle<StepShape_ConnectedFaceSet>> aShells;
+  aShells.Append(theSolid->Outer());
+  if (const occ::handle<StepShape_BrepWithVoids> aVoids =
+        occ::down_cast<StepShape_BrepWithVoids>(theSolid))
+  {
+    for (int i = 1; i <= aVoids->NbVoids(); ++i)
+    {
+      const occ::handle<StepShape_OrientedClosedShell> aVoid = aVoids->VoidsValue(i);
+      if (aVoid.IsNull())
+      {
+        return false;
+      }
+      theEntities.push_back(aVoid.get());
+      aShells.Append(aVoid->ClosedShellElement());
+    }
+  }
+  for (const occ::handle<StepShape_ConnectedFaceSet>& aShell : aShells)
+  {
+    if (aShell.IsNull())
+    {
+      return false;
+    }
+    theEntities.push_back(aShell.get());
+    for (int i = 1; i <= aShell->NbCfsFaces(); ++i)
+    {
+      occ::handle<StepShape_Face> aFace = aShell->CfsFacesValue(i);
+      while (!aFace.IsNull() && aFace->IsKind(STANDARD_TYPE(StepShape_OrientedFace)))
+      {
+        theEntities.push_back(aFace.get());
+        aFace = occ::down_cast<StepShape_OrientedFace>(aFace)->FaceElement();
+      }
+      if (aFace.IsNull())
+      {
+        return false;
+      }
+      theEntities.push_back(aFace.get());
+      if (const occ::handle<StepShape_FaceSurface> aFaceSurface =
+            occ::down_cast<StepShape_FaceSurface>(aFace))
+      {
+        if (!aFaceSurface->FaceGeometry().IsNull())
+        {
+          theEntities.push_back(aFaceSurface->FaceGeometry().get());
+        }
+      }
+      for (int j = 1; j <= aFace->NbBounds(); ++j)
+      {
+        const occ::handle<StepShape_FaceBound> aBound = aFace->BoundsValue(j);
+        if (aBound.IsNull() || aBound->Bound().IsNull())
+        {
+          return false;
+        }
+        theEntities.push_back(aBound.get());
+        const occ::handle<StepShape_Loop>& aLoop = aBound->Bound();
+        theEntities.push_back(aLoop.get());
+        if (const occ::handle<StepShape_VertexLoop> aVertexLoop =
+              occ::down_cast<StepShape_VertexLoop>(aLoop))
+        {
+          if (!aVertexLoop->LoopVertex().IsNull())
+          {
+            theEntities.push_back(aVertexLoop->LoopVertex().get());
+          }
+          continue;
+        }
+        if (const occ::handle<StepShape_PolyLoop> aPolyLoop = occ::down_cast<StepShape_PolyLoop>(aLoop))
+        {
+          for (int k = 1; k <= aPolyLoop->NbPolygon(); ++k)
+          {
+            if (!aPolyLoop->PolygonValue(k).IsNull())
+            {
+              theEntities.push_back(aPolyLoop->PolygonValue(k).get());
+            }
+          }
+          continue;
+        }
+        const occ::handle<StepShape_EdgeLoop> anEdgeLoop = occ::down_cast<StepShape_EdgeLoop>(aLoop);
+        if (anEdgeLoop.IsNull())
+        {
+          return false;
+        }
+        for (int k = 1; k <= anEdgeLoop->NbEdgeList(); ++k)
+        {
+          occ::handle<StepShape_Edge> anEdge = anEdgeLoop->EdgeListValue(k);
+          while (!anEdge.IsNull() && anEdge->IsKind(STANDARD_TYPE(StepShape_OrientedEdge)))
+          {
+            collectEdgeEntities(anEdge, theEntities);
+            anEdge = occ::down_cast<StepShape_OrientedEdge>(anEdge)->EdgeElement();
+          }
+          if (anEdge.IsNull())
+          {
+            continue;
+          }
+          collectEdgeEntities(anEdge, theEntities);
+          const occ::handle<StepShape_EdgeCurve> anEdgeCurve =
+            occ::down_cast<StepShape_EdgeCurve>(anEdge);
+          if (anEdgeCurve.IsNull())
+          {
+            continue; // not translated: no curve is looked up
+          }
+          const occ::handle<StepGeom_Curve> aCurve = anEdgeCurve->EdgeGeometry();
+          if (aCurve.IsNull())
+          {
+            continue;
+          }
+          theEntities.push_back(aCurve.get());
+          if (const occ::handle<StepGeom_SurfaceCurve> aSurfaceCurve =
+                occ::down_cast<StepGeom_SurfaceCurve>(aCurve))
+          {
+            if (!aSurfaceCurve->Curve3d().IsNull())
+            {
+              theEntities.push_back(aSurfaceCurve->Curve3d().get());
+            }
+          }
+        }
+      }
+    }
+  }
+  return true;
+}
