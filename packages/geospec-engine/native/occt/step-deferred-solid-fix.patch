+#if !defined(__EMSCRIPTEN__)
+bool deferredFixesActive(const std::shared_ptr<STEPControl_ActorReadDeferredFixes>& theFixes,
+                         const int                                                  theDepth)
+{
+  return theFixes && theFixes->Workers >= 1 && !theFixes->Diverged && theDepth > 0;
+}
+
+// Merges one finished completion into the transfer and gives its result to the
+// stand-in, then lets go of everything the job holds.
+void finalizeDeferredFix(STEPControl_ActorReadDeferredFixes&           theFixes,
+                         const occ::handle<Transfer_TransientProcess>& theTP,
+                         STEPControl_ActorReadDeferredFixes::Job&      theJob)
+{
+  if (!theFixes.Diverged)
+  {
+    try
+    {
+      OCC_CATCH_SIGNALS
+      if (theJob.Failed)
+      {
+        theFixes.Diverged = true;
+      }
+      else
+      {
+        if (mergeTransferInfoRange(theTP, theJob.Context, theJob.FirstTPItem, theJob.LastTPItem)
+            != 0)
+        {
+          ++theFixes.NbReshaped;
+        }
+        if (!fillStandIn(theJob))
+        {
+          theFixes.Diverged = true;
+        }
+      }
+    }
+    catch (...)
+    {
+      theFixes.Diverged = true;
+    }
+  }
+  for (const Standard_Transient* anEntity : theJob.Entities)
+  {
+    theFixes.PendingEntities.erase(anEntity);
+  }
+  theJob.Result.Nullify();
+  theJob.Context.Nullify();
+}
+
+// Finalizes the pending completions in item order: every finished one at the front,
+// then, while more than theToKeep are pending, the front one once it finishes.
+// Once the transfer diverges, every pending completion is awaited: nothing completed
+// in place afterwards may run beside a worker.
+void finalizeDeferredFixes(STEPControl_ActorReadDeferredFixes&           theFixes,
+                           const occ::handle<Transfer_TransientProcess>& theTP,
+                           const size_t                                  theToKeep)
+{
+  while (!theFixes.Pending.empty())
+  {
+    STEPControl_ActorReadDeferredFixes::Job& aJob = *theFixes.Pending.front();
+    {
+      std::unique_lock<std::mutex> aLock(theFixes.Mutex);
+      if (!aJob.Done)
+      {
+        if (theFixes.Pending.size() <= theToKeep && !theFixes.Diverged)
+        {
+          return;
+        }
+        theFixes.Finished.wait(aLock, [&aJob] { return aJob.Done; });
+      }
+    }
+    finalizeDeferredFix(theFixes, theTP, aJob);
+    theFixes.Pending.pop_front();
+  }
+}
+
+// Awaits every pending completion and finalizes them in item order.
+void drainDeferredFixes(STEPControl_ActorReadDeferredFixes&           theFixes,
+                        const occ::handle<Transfer_TransientProcess>& theTP)
+{
+  finalizeDeferredFixes(theFixes, theTP, 0);
+}
+
+void stopDeferredFixWorkers(STEPControl_ActorReadDeferredFixes& theFixes)
+{
+  {
+    const std::lock_guard<std::mutex> aLock(theFixes.Mutex);
+    theFixes.Stop = true;
+  }
+  theFixes.Wake.notify_all();
+  #if defined(_WIN32)
+  for (std::thread& aThread : theFixes.Threads)
+  {
+    aThread.join();
+  }
+  #else
+  for (const pthread_t aThread : theFixes.Threads)
+  {
+    pthread_join(aThread, nullptr);
+  }
+  #endif
+  theFixes.Threads.clear();
+  theFixes.Stop = false;
+  theFixes.StandIns.clear();
+}
+
+// True when a pending completion may change what the transfer process holds for
+// theEntity: its solid's translation bound it, or it opens that completion's merge range.
+bool boundByPendingFix(const STEPControl_ActorReadDeferredFixes&     theFixes,
+                       const occ::handle<Transfer_TransientProcess>& theTP,
+                       const occ::handle<Standard_Transient>&        theEntity)
+{
+  if (theFixes.Pending.empty() || theEntity.IsNull())
+  {
+    return false;
+  }
+  const int anIndex = theTP->MapIndex(theEntity);
+  if (anIndex == 0)
+  {
+    return false;
+  }
+  for (const std::unique_ptr<STEPControl_ActorReadDeferredFixes::Job>& aJob : theFixes.Pending)
+  {
+    if (anIndex >= aJob->FirstTPItem && anIndex <= aJob->LastTPItem)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+#endif
+
+// TP->Find(theEntity), after the pending completions when one of them may change its binding.
+occ::handle<Transfer_Binder> settledFind(
+  const std::shared_ptr<STEPControl_ActorReadDeferredFixes>& theFixes,
+  const occ::handle<Transfer_TransientProcess>&              theTP,
+  const occ::handle<Standard_Transient>&                     theEntity)
+{
+#if !defined(__EMSCRIPTEN__)
+  if (theFixes && boundByPendingFix(*theFixes, theTP, theEntity))
+  {
+    drainDeferredFixes(*theFixes, theTP);
+  }
+#else
+  (void)theFixes;
+#endif
+  return theTP->Find(theEntity);
+}
+
+#if !defined(__EMSCRIPTEN__)
+bool standInPending(const STEPControl_ActorReadDeferredFixes& theFixes, const TopoDS_Shape& theShape)
+{
+  for (const std::unique_ptr<STEPControl_ActorReadDeferredFixes::Job>& aJob : theFixes.Pending)
+  {
+    if (aJob->StandIn.TShape() == theShape.TShape())
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Queues a completion; false when no worker thread can be started (complete in place).
+bool submitDeferredFix(STEPControl_ActorReadDeferredFixes&                         theFixes,
+                       const occ::handle<Transfer_TransientProcess>&               theTP,
+                       std::unique_ptr<STEPControl_ActorReadDeferredFixes::Job>&& theJob)
+{
+  if (theFixes.Threads.empty())
+  {
+    // Initialize lazily built process-wide state on this thread, before any worker
+    // runs: the shape-processing operator registry and BRepLib's default plane.
+    ShapeProcess_OperLibrary::Init();
+    (void)BRepLib::Plane();
+  }
+  if (theFixes.Threads.size() < static_cast<size_t>(theFixes.Workers) && !startWorker(theFixes)
+      && theFixes.Threads.empty())
+  {
+    return false;
+  }
+  // Peak memory stays near the in-place transfer's: finalize what has finished,
+  // and keep at most two pending completions per worker.
+  finalizeDeferredFixes(theFixes, theTP, 2 * static_cast<size_t>(theFixes.Workers) - 1);
+  if (theFixes.Diverged)
+  {
+    return false;
+  }
+  if (std::fegetenv(&theJob->FloatEnvironment) != 0)
+  {
+    return false;
+  }
+  // Everything this solid's translation bound, besides what the walk found.
+  for (int i = theJob->FirstTPItem + 1; i <= theJob->LastTPItem; ++i)
+  {
+    theJob->Entities.push_back(theTP->Mapped(i).get());
+  }
+  STEPControl_ActorReadDeferredFixes::Job* aJob = theJob.get();
+  theFixes.StandIns.insert(aJob->StandIn.TShape().get());
+  theFixes.PendingEntities.insert(aJob->Entities.begin(), aJob->Entities.end());
+  theFixes.Pending.push_back(std::move(theJob));
+  {
+    const std::lock_guard<std::mutex> aLock(theFixes.Mutex);
+    theFixes.Queue.push_back(aJob);
+  }
+  theFixes.Wake.notify_one();
+  ++theFixes.NbDeferred;
+  return true;
+}
+#endif
