+// GeoSpec: deferred translation completion of independent manifold solids.
+//
+// Completion is the shape processing that finishes a solid's translation with the
+// caller's fix parameters. GeoSpec's authored profile limits it to pcurves,
+// same-parameter, seams and wire order: it never repairs authored geometry.
+//
+// With SetDeferredFixWorkers(n), n of 1 or 2, a manifold solid item is built in
+// place, as before, but its ProcessShape runs on one of n worker threads while the
+// transfer goes on. The transfer binds a new empty solid (the stand-in) where the
+// completed solid would have been bound. The finished completions are finalized in item
+// order as the transfer goes on, and all of them before anything can read what a
+// pending completion may change and at the end of the root transfer: the transfer
+// information of each item's own range of transfer-process entries is merged
+// exactly as the in-place completion merges it, and the completed solid's children and
+// status flags are given to the stand-in, which every result already holds. So
+// every result is the in-place result.
+//
+// What a pending completion may change is everything its solid's translation bound in
+// the transfer process (shells, faces, loops, edges, vertices, cached curves). A
+// lookup of any of those entities first waits for the pending completions. A solid
+// whose own entities include one of them is completed in place, after the pending
+// completions, and so is a solid whose topology has a kind this walk does not know;
+// every other kind of item that builds a shape waits for the pending completions
+// first. A completion that throws, or whose result the stand-in cannot hold, marks the
+// transfer as diverged: nothing more is deferred, and the caller must repeat the
+// read in place. At most two completions per worker are pending at a time.
+// ============================================================================
+
+struct STEPControl_ActorReadDeferredFixes
+{
+  int  Workers    = 0;
+  int  NbDeferred = 0;
+  int  NbShared   = 0;
+  int  NbReshaped = 0;
+  bool Diverged   = false;
+  bool StandInMismatch = false; // qualification: every stand-in check fails
+#if !defined(__EMSCRIPTEN__)
+  struct Job
+  {
+    TopoDS_Shape                           Source;      // the built solid, not yet completed (private)
+    TopoDS_Shape                           StandIn;     // the empty solid the transfer binds
+    XSAlgo_ShapeProcessor::ParameterMap    Parameters;  // as the in-place completion builds them
+    ShapeProcess::OperationsFlags          Operations;
+    std::fenv_t                            FloatEnvironment; // the submitting thread's
+    int                                    FirstTPItem = 0; // the in-place merge range
+    int                                    LastTPItem  = 0;
+    uint16_t                               StandInFlags = 0;
+    std::vector<const Standard_Transient*> Entities;    // what this job adds to PendingEntities
+    TopoDS_Shape                           Result;
+    occ::handle<ShapeProcess_ShapeContext> Context;
+    bool                                   Done   = false;
+    bool                                   Failed = false;
+  };
+
+  std::mutex                                  Mutex;
+  std::condition_variable                     Wake;
+  std::condition_variable                     Finished;
+  std::deque<Job*>                            Queue;
+  std::deque<std::unique_ptr<Job>>            Pending;   // in item order
+  #if defined(_WIN32)
+  std::vector<std::thread>                    Threads;
+  #else
+  std::vector<pthread_t>                      Threads;
+  #endif
+  bool                                        Stop = false;
+  std::unordered_set<const Standard_Transient*> PendingEntities;
+  std::unordered_set<const TopoDS_TShape*>      StandIns;  // every stand-in of the root transfer
+#endif
+};
