+/// A body whose file topology leaves edges with one use (the cube less its top face)
+/// is built from that topology and stays open: it is never stitched, healed or
+/// integrated into a solid.
+#[test]
+fn an_unpaired_edge_leaves_the_body_open() {
+    let mut body = cube();
+    let top = body.shells[0].faces.remove(1);
+    body.faces.remove(top);
+    for shell in &mut body.shells {
+        for face in &mut shell.faces {
+            if *face > top {
+                *face -= 1;
+            }
+        }
+    }
+    let built = build_body(&body, options(false)).unwrap();
+    assert_eq!(built.path, BuildPath::Topology);
+    assert!(built.topology_note.is_none());
+    assert!(!is_closed_solid(&built.brep));
+    assert_eq!(
+        (built.brep.face_list().len(), built.brep.edge_list().len()),
+        (5, 12)
+    );
+}
+
+/// A closed surface model is built from its topology as the sheet it is: no region,
+/// never stitched into a solid.
+#[test]
+fn a_shell_stays_a_shell() {
+    let mut body = cube();
+    body.kind = BodyKind::ShellModel;
+    let built = build_body(&body, options(false)).unwrap();
+    assert_eq!(built.path, BuildPath::Topology);
+    assert!(!is_closed_solid(&built.brep));
+    assert_eq!(region_census(&built.brep).unwrap(), (0, 0, 0));
+}
