+/// Exports `b`, reads it back and checks the stitched build of it is valid (what the
+/// default build gave before it stopped stitching). The default topology build of the
+/// same export keeps every face, but `check_brep` reports its infinite region wrong
+/// (Test #8): a structural defect the parity lane's geometric validity (S6) owns, kept
+/// visible here rather than stitched over.
 fn validated_roundtrip(b: &Brep) -> Result<Brep, Box<dyn std::error::Error>> {
     let exported = step_export::write(&step_brep::brep_to_model(b)?)?;
     let parsed = step_import::import(exported.as_bytes(), &step_import::Limits::default())?;
     assert!(parsed.skipped.is_empty());
     let body = parsed.bodies.first().ok_or("missing exported body")?;
-    let built = step_brep::build_body(body, step_brep::BuildOptions::default())?;
+    let mut topology = step_brep::build_body(body, step_brep::BuildOptions::default())?;
+    assert!(topology.face_failures.is_empty());
+    let report = check_brep(&mut Kernel::default(), &mut topology.brep, CheckLevel::Level2)?;
+    assert!(
+        report.lines().iter().any(|l| l.contains("Bad Infinite Region")),
+        "the topology build's known defect changed: {:?}",
+        report.lines()
+    );
+    let built = step_brep::build_body(
+        body,
+        step_brep::BuildOptions {
+            mode: step_brep::BuildMode::StitchOnly,
+            ..step_brep::BuildOptions::default()
+        },
+    )?;
     assert!(built.face_failures.is_empty());
     let mut read = built.brep;
     assert_eq!(read.face_list().len(), b.face_list().len());
