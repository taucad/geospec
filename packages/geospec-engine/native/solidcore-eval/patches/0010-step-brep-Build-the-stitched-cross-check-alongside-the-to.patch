+fn build_stitched_unless(
+    body: &Body,
+    file_pcurves: &sm::FilePcurves,
+    options: BuildOptions,
+    cancel: &CancelToken,
+) -> Option<Result<(Brep, PcurveStats), BuildError>> {
+    let built = stitch_until(body, file_pcurves, options, Some(cancel));
+    if cancel.is_cancelled() {
+        return None;
+    }
+    match built {
+        Ok(built) => Some(Ok(built)),
+        Err(Halt::Error(error)) => Some(Err(error)),
+        Err(Halt::Cancelled) => None,
+    }
+}
