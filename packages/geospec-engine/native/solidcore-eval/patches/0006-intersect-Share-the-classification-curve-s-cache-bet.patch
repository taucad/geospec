diff --git a/crates/solidcore/src/intersect/curve_class/p1.rs b/crates/solidcore/src/intersect/curve_class/p1.rs
index ca9918a10..e240ee3be 100644
--- a/crates/solidcore/src/intersect/curve_class/p1.rs
+++ b/crates/solidcore/src/intersect/curve_class/p1.rs
@@ -589,6 +589,64 @@ pub struct CurveClassification<O> {
     pub(super) allocated: bool,
     /// `m_bIgnoreTangency`.
     pub(super) ignore_tangency: bool,
+    /// (not upstream) The classification curve's cache left by the vertex pass, for
+    /// the edge pass: upstream keeps one cache on the curve for both.
+    pub(super) source_cache: SourceCacheSeed,
+}
+
+/// A curve cache of a classification's own curve, with the token of the curve value it
+/// was built on (not upstream: upstream keeps the cache on the curve object, so the
+/// vertex and edge passes of one classification share it). It is not part of the
+/// classification's value: clones start without it and it never affects equality.
+#[derive(Default)]
+pub(crate) struct SourceCacheSeed(
+    Option<(
+        crate::curve::curve::p5::CurveEditToken,
+        crate::curve::curve_cache::CurveCache<()>,
+    )>,
+);
+
+impl SourceCacheSeed {
+    /// Keeps `cache`, built on `curve` as it is now.
+    pub(crate) fn store<P: Copy + PartialEq>(
+        &mut self,
+        curve: &Curve,
+        cache: &crate::curve::curve_cache::CurveCache<P>,
+    ) {
+        self.0 = cache.retag::<()>(None).map(|c| (curve.edit_token(), c));
+    }
+
+    /// The kept cache naming `handle`, when it was built on `curve` as it is now.
+    pub(crate) fn take<P: Copy + PartialEq>(
+        &mut self,
+        curve: &Curve,
+        handle: P,
+    ) -> Option<crate::curve::curve_cache::CurveCache<P>> {
+        let (token, cache) = self.0.take()?;
+        if token.matches(curve) {
+            cache.retag(Some(handle))
+        } else {
+            None
+        }
+    }
+}
+
+impl Clone for SourceCacheSeed {
+    fn clone(&self) -> Self {
+        Self(None)
+    }
+}
+
+impl PartialEq for SourceCacheSeed {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+
+impl core::fmt::Debug for SourceCacheSeed {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.write_str("SourceCacheSeed")
+    }
 }
 
 /// How `SetPointClassParameters` reaches the classifications' objects: read-only, or
@@ -663,6 +721,7 @@ impl<O: ClassObject> CurveClassification<O> {
             data: Vec::new(),
             allocated: false,
             ignore_tangency: false,
+            source_cache: SourceCacheSeed::default(),
         }
     }
 
@@ -727,6 +786,7 @@ impl<O: ClassObject> CurveClassification<O> {
             data,
             allocated: self.allocated,
             ignore_tangency: self.ignore_tangency,
+            source_cache: SourceCacheSeed::default(),
         })
     }
 
