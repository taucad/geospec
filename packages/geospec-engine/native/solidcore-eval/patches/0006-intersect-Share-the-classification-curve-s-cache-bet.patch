         for &vertex in vertices {
             let geometry = access.geometry();
             let vertex_zone = object_zone_tol_3d(k, geometry, Some(vertex))?;
@@ -959,6 +968,14 @@ impl<O: ClassObject> CurveClassification<O> {
                 )?;
             }
         }
+        // keep the curve's cache for the edge pass (a cache left here was built after
+        // the last edit of the curve: every edit above drops it first)
+        if let (Some(cache), None) = (&curve_cache, &wrapped) {
+            let curve = self.curve_geometry(access.geometry())?;
+            let mut seed = core::mem::take(&mut self.source_cache);
+            seed.store(curve, cache);
+            self.source_cache = seed;
+        }
         Ok(())
     }
 
