+    fn take_step(&mut self, ii: u32, zone_tol: f64) -> Option<DropStep> {
+        let slot = self.steps.get_mut(usize::try_from(ii).ok()?)?;
+        if slot.as_ref()?.zone_tol != zone_tol.to_bits() {
+            return None;
+        }
+        slot.take()
+    }
