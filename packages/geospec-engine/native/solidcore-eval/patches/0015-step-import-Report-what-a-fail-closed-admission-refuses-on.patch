+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::part21::{parse, Limits};
+
+    fn findings(data: &str) -> Vec<Finding> {
+        let text = format!(
+            "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION((''),'2;1');\n\
+             FILE_NAME('','',(''),(''),'','','');\nFILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));\n\
+             ENDSEC;\nDATA;\n{data}\nENDSEC;\nEND-ISO-10303-21;\n"
+        );
+        let f = parse(text.as_bytes(), &Limits::default()).unwrap();
+        let mut out = lexical(text.as_bytes());
+        out.extend(file(&f));
+        out
+    }
+
+    fn classes(data: &str) -> Vec<Class> {
+        findings(data).into_iter().map(|f| f.class).collect()
+    }
+
+    #[test]
+    fn a_clean_file_has_no_finding() {
+        assert!(findings("#1=CARTESIAN_POINT('',(0.,0.,0.));").is_empty());
+    }
+
+    #[test]
+    fn form_feed_between_tokens_is_syntax() {
+        assert_eq!(
+            classes("#1\u{c}=CARTESIAN_POINT('',(0.,0.,0.));"),
+            [Class::Syntax]
+        );
+        // inside a string or a comment it is not
+        assert!(findings("#1=CARTESIAN_POINT('a\u{c}b',(0.,0.,0.));/*\u{c}*/").is_empty());
+    }
+
+    #[test]
+    fn empty_and_parameterised_data_sections_are_syntax() {
+        assert_eq!(classes(""), [Class::Syntax]);
+        let text = "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION((''),'2;1');\n\
+             FILE_NAME('','',(''),(''),'','','');\nFILE_SCHEMA(('X'));\nENDSEC;\n\
+             DATA('a',('X'));\n#1=CARTESIAN_POINT('',(0.,0.,0.));\nENDSEC;\nEND-ISO-10303-21;\n";
+        let f = parse(text.as_bytes(), &Limits::default()).unwrap();
+        let c: Vec<Class> = file(&f).into_iter().map(|f| f.class).collect();
+        assert_eq!(c, [Class::Syntax]);
+    }
+
+    #[test]
+    fn header_shapes_are_checked() {
+        let text = "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION((''),'2;1');\n\
+             FILE_NAME('','','',(''),'','',$);\nFILE_SCHEMA(('X'));\nENDSEC;\n\
+             DATA;\n#1=CARTESIAN_POINT('',(0.,0.,0.));\nENDSEC;\nEND-ISO-10303-21;\n";
+        let f = parse(text.as_bytes(), &Limits::default()).unwrap();
+        let c: Vec<Class> = file(&f).into_iter().map(|f| f.class).collect();
+        assert_eq!(c, [Class::Header, Class::Header]);
+        let text = text.replace(
+            "FILE_NAME('','','',(''),'','',$)",
+            "FILE_NAME('','',(''),(''),'','')",
+        );
+        let f = parse(text.as_bytes(), &Limits::default()).unwrap();
+        let c: Vec<Class> = file(&f).into_iter().map(|f| f.class).collect();
+        assert_eq!(c, [Class::Header]);
+    }
+
+    #[test]
+    fn schema_rules() {
+        // a required label left unset
+        assert_eq!(
+            classes("#1=CARTESIAN_POINT($,(0.,0.,0.));"),
+            [Class::Schema]
+        );
+        // a parameter count OCCT refuses
+        assert_eq!(
+            classes("#1=PLANE(#2);#2=CARTESIAN_POINT('',(0.,0.,0.));"),
+            [Class::Schema]
+        );
+        // a rational B-spline's knot specification left unset
+        assert_eq!(
+            classes(
+                "#1=(B_SPLINE_CURVE_WITH_KNOTS((2,2),(0.,1.),$) RATIONAL_B_SPLINE_CURVE((1.,1.)));"
+            ),
+            [Class::Schema]
+        );
+        // records out of alphabetical order
+        assert_eq!(
+            classes("#1=(NAMED_UNIT(*) SOLID_ANGLE_UNIT() SI_UNIT($,.STERADIAN.));"),
+            [Class::Schema]
+        );
+        // a conversion-based unit with derived dimensions
+        assert_eq!(
+            classes("#1=(CONVERSION_BASED_UNIT('inch',#2) LENGTH_UNIT() NAMED_UNIT(*));#2=CARTESIAN_POINT('',(0.,0.,0.));"),
+            [Class::Schema]
+        );
+        assert!(findings(
+            "#1=(CONVERSION_BASED_UNIT('inch',#2) LENGTH_UNIT() NAMED_UNIT(#3));#2=CARTESIAN_POINT('',(0.,0.,0.));#3=CARTESIAN_POINT('',(0.,0.,0.));"
+        )
+        .is_empty());
+        // a required entity left unset
+        assert_eq!(
+            classes("#1=PRODUCT_DEFINITION_SHAPE('','',$);"),
+            [Class::Schema]
+        );
+        // an illegal referenced type
+        assert_eq!(
+            classes("#1=POINT_STYLE('',#2,POSITIVE_LENGTH_MEASURE(1.),#3);#2=PRE_DEFINED_MARKER('x');#3=CARTESIAN_POINT('',(0.,0.,0.));"),
+            [Class::Schema]
+        );
+        // topology typed strictly
+        assert_eq!(
+            classes("#1=FACE_BOUND('',#2,.T.);#2=CARTESIAN_POINT('',(0.,0.,0.));"),
+            [Class::Schema]
+        );
+        assert!(findings("#1=FACE_BOUND('',#2,.T.);#2=EDGE_LOOP('',());").is_empty());
+        // a list left unset
+        assert_eq!(
+            classes("#1=COMPLEX_TRIANGULATED_SURFACE_SET('',#2,3,$,$,((1,2,3)),());#2=CARTESIAN_POINT('',(0.,0.,0.));"),
+            [Class::Schema]
+        );
+    }
+
