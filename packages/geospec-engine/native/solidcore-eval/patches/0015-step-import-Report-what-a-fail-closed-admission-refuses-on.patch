+//! Admission findings: what in a file a fail-closed reader refuses on.
+//!
+//! The importer reads leniently: it maps what it understands and reports the rest as
+//! diagnostics. `GeoSpec` admits a STEP subject only when the reader that admits it
+//! refuses what OCCT's reader refuses (the `GeoSpec` admission profile), and refuses
+//! what neither engine may guess. Each [`Finding`] names one such case; the caller
+//! decides the refusal. Nothing here changes what [`crate::map`] builds.
+//!
+//! The rules mirror the checks OCCT's STEP reader (`StepData`, `STEPControl`,
+//! `STEPConstruct_ExternRefs`) applies, one per refusal message OCCT gives, each
+//! narrowed to the case that message describes. They are a mirror of observed
+//! behaviour, not OCCT's schema: an entity OCCT checks and no rule covers is read
+//! as before.
+
+use crate::part21::{Instance, Param, Record, StepFile};
+
+/// Why a file is refused.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Class {
+    /// Part 21 syntax OCCT's reader refuses: a form feed between tokens, an empty
+    /// data section, a data section with parameters.
+    Syntax,
+    /// A `HEADER` entity whose parameters do not have the shape Part 21 gives it.
+    Header,
+    /// An entity whose parameters do not have the count, kind or referenced type
+    /// OCCT's reader requires.
+    Schema,
+    /// A reference to an entity the file does not define.
+    DanglingReference,
+    /// A reference to another file: the subject is incomplete.
+    ExternalReference,
+    /// A body whose length or plane-angle unit is not stated by its representation
+    /// context: its coordinates would be a guess.
+    UnitsAssumed,
+    /// Assembly instancing (`MAPPED_ITEM`, `CONTEXT_DEPENDENT_SHAPE_REPRESENTATION`)
+    /// that the importer counts but does not apply.
+    PlacementsNotApplied,
+}
+
+impl Class {
+    /// A stable name for reports.
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Class::Syntax => "part21-syntax",
+            Class::Header => "part21-header",
+            Class::Schema => "schema",
+            Class::DanglingReference => "dangling-reference",
+            Class::ExternalReference => "external-reference",
+            Class::UnitsAssumed => "units-assumed",
+            Class::PlacementsNotApplied => "placements-not-applied",
+        }
+    }
+}
+
+/// One reason to refuse the file.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Finding {
+    /// The class.
+    pub class: Class,
+    /// The entity it is about, when it has one.
+    pub step_id: Option<u64>,
+    /// What was found.
+    pub message: String,
+}
+
+impl Finding {
+    pub(crate) fn new(class: Class, step_id: Option<u64>, message: impl Into<String>) -> Self {
+        Self {
+            class,
+            step_id,
+            message: message.into(),
+        }
+    }
+}
+
+/// Findings from the raw bytes: a form feed outside strings and comments (OCCT's
+/// Part 21 lexer has no rule for it).
+pub fn lexical(bytes: &[u8]) -> Vec<Finding> {
+    let mut line = 1_usize;
+    let mut i = 0;
+    while let Some(&c) = bytes.get(i) {
+        match c {
+            b'\n' => line += 1,
+            b'\'' => {
+                // a string: '' is a quote inside it
+                i += 1;
+                loop {
+                    match bytes.get(i) {
+                        None => return Vec::new(),
+                        Some(b'\'') if bytes.get(i + 1) == Some(&b'\'') => i += 1,
+                        Some(b'\'') => break,
+                        Some(b'\n') => line += 1,
+                        Some(_) => {}
+                    }
+                    i += 1;
+                }
+            }
+            b'/' if bytes.get(i + 1) == Some(&b'*') => {
+                i += 2;
+                loop {
+                    match bytes.get(i) {
+                        None => return Vec::new(),
+                        Some(b'*') if bytes.get(i + 1) == Some(&b'/') => {
+                            i += 1;
+                            break;
+                        }
+                        Some(b'\n') => line += 1,
+                        Some(_) => {}
+                    }
+                    i += 1;
+                }
+            }
+            0x0c => {
+                return vec![Finding::new(
+                    Class::Syntax,
+                    None,
+                    format!("line {line}: form feed between tokens"),
+                )]
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    Vec::new()
+}
+
+/// Findings from the parsed file's sections, header and data-section entities.
+pub fn file(file: &StepFile) -> Vec<Finding> {
+    let mut out = Vec::new();
+    sections(file, &mut out);
+    header(file, &mut out);
+    for (&id, inst) in &file.entities {
+        entity(file, id, inst, &mut out);
+    }
+    external_references(file, &mut out);
+    out
+}
+
+fn sections(file: &StepFile, out: &mut Vec<Finding>) {
+    for (n, s) in file.syntax.data_sections.iter().enumerate() {
+        if s.parameters {
+            out.push(Finding::new(
+                Class::Syntax,
+                None,
+                format!("DATA section {} has parameters (edition 3)", n + 1),
+            ));
+        }
+        if s.instances == 0 {
+            out.push(Finding::new(
+                Class::Syntax,
+                None,
+                format!("DATA section {} has no entity instance", n + 1),
+            ));
+        }
+    }
+}
+
+/// The parameter kinds of the three required header entities.
+#[derive(Clone, Copy)]
+enum Kind {
+    Str,
+    StrList,
+}
+
+const HEADER_SHAPES: [(&str, &[Kind]); 3] = [
+    ("FILE_DESCRIPTION", &[Kind::StrList, Kind::Str]),
+    (
+        "FILE_NAME",
+        &[
+            Kind::Str,
+            Kind::Str,
+            Kind::StrList,
+            Kind::StrList,
+            Kind::Str,
+            Kind::Str,
+            Kind::Str,
+        ],
+    ),
+    ("FILE_SCHEMA", &[Kind::StrList]),
+];
+
+fn header(file: &StepFile, out: &mut Vec<Finding>) {
+    for r in &file.syntax.header_records {
+        let Some((_, shape)) = HEADER_SHAPES.iter().find(|(n, _)| *n == r.name) else {
+            continue;
+        };
+        if r.params.len() != shape.len() {
+            out.push(Finding::new(
+                Class::Header,
+                None,
+                format!(
+                    "{} has {} parameters, not {}",
+                    r.name,
+                    r.params.len(),
+                    shape.len()
+                ),
+            ));
+            continue;
+        }
+        for (i, (p, k)) in r.params.iter().zip(shape.iter()).enumerate() {
+            let ok = match k {
+                Kind::Str => matches!(p, Param::Str(_)),
+                Kind::StrList => matches!(p, Param::List(_)),
+            };
+            if !ok {
+                out.push(Finding::new(
+                    Class::Header,
+                    None,
+                    format!(
+                        "{} parameter {} is not a {}",
+                        r.name,
+                        i + 1,
+                        match k {
+                            Kind::Str => "string",
+                            Kind::StrList => "list",
+                        }
+                    ),
+                ));
+            }
+        }
+    }
+}
+
+/// Simple entities whose parameter count OCCT's reader checks, with that count (as
+/// OCCT counts it) where the corpus shows a file refused for it.
+const COUNTS: [(&str, usize); 9] = [
+    ("PLANE", 2),
+    ("CIRCLE", 3),
+    ("FACE_BOUND", 3),
+    ("FACE_OUTER_BOUND", 3),
+    ("APPLICATION_CONTEXT", 1),
+    ("TEXT_LITERAL", 6),
+    ("SURFACE_STYLE_RENDERING", 2),
+    ("CARTESIAN_TRANSFORMATION_OPERATOR_3D", 8),
+    ("CARTESIAN_TRANSFORMATION_OPERATOR_2D", 7),
+];
+
+/// Records (simple, or one part of a complex instance) with their parameter count
+/// in a complex instance.
+const COMPLEX_COUNTS: [(&str, usize); 4] = [
+    ("B_SPLINE_CURVE_WITH_KNOTS", 3),
+    ("B_SPLINE_SURFACE_WITH_KNOTS", 5),
+    ("REPRESENTATION_ITEM", 1),
+    ("SI_UNIT", 2),
+];
+
+/// Geometric and topological representation items whose `name` (a label, the first
+/// parameter) OCCT reads as a required string.
+const LABELLED: [&str; 34] = [
+    "CARTESIAN_POINT",
+    "DIRECTION",
+    "VECTOR",
+    "AXIS1_PLACEMENT",
+    "AXIS2_PLACEMENT_2D",
+    "AXIS2_PLACEMENT_3D",
+    "LINE",
+    "CIRCLE",
+    "ELLIPSE",
+    "TRIMMED_CURVE",
+    "B_SPLINE_CURVE_WITH_KNOTS",
+    "B_SPLINE_SURFACE_WITH_KNOTS",
+    "PLANE",
+    "CYLINDRICAL_SURFACE",
+    "CONICAL_SURFACE",
+    "SPHERICAL_SURFACE",
+    "TOROIDAL_SURFACE",
+    "SURFACE_OF_REVOLUTION",
+    "SURFACE_OF_LINEAR_EXTRUSION",
+    "PCURVE",
+    "SURFACE_CURVE",
+    "SEAM_CURVE",
+    "VERTEX_POINT",
+    "EDGE_CURVE",
+    "ORIENTED_EDGE",
+    "EDGE_LOOP",
+    "FACE_BOUND",
+    "FACE_OUTER_BOUND",
+    "ADVANCED_FACE",
+    "CLOSED_SHELL",
+    "OPEN_SHELL",
+    "MANIFOLD_SOLID_BREP",
+    "SHAPE_REPRESENTATION",
+    "ADVANCED_BREP_SHAPE_REPRESENTATION",
+];
+
+/// A parameter that must be an enumeration, by record and index.
+const ENUMS: [(&str, usize, usize); 4] = [
+    // (record, index in a simple instance, index in a complex instance)
+    ("B_SPLINE_CURVE_WITH_KNOTS", 8, 2),
+    ("B_SPLINE_SURFACE_WITH_KNOTS", 12, 4),
+    ("SURFACE_STYLE_RENDERING", 0, 0),
+    ("SURFACE_STYLE_RENDERING_WITH_PROPERTIES", 0, 0),
+];
+
+/// A parameter that must be a list, by record and index.
+const LISTS: [(&str, usize); 1] = [("COMPLEX_TRIANGULATED_SURFACE_SET", 3)];
+
+/// A parameter that must be an entity reference, by record and index.
+const REFS: [(&str, usize); 5] = [
+    ("PRODUCT_DEFINITION_SHAPE", 2),
+    ("ANNOTATION_PLANE", 2),
+    ("REPOSITIONED_TESSELLATED_ITEM", 0),
+    ("VOLUME_UNIT", 0),
+    ("ITEM_IDENTIFIED_REPRESENTATION_USAGE", 4),
+];
+
+/// A reference OCCT refuses as "Entity has illegal type": (record, parameter index,
+/// a record the referenced instance must not have).
+const ILLEGAL: [(&str, usize, &str); 8] = [
+    (
+        "CONTEXT_DEPENDENT_OVER_RIDING_STYLED_ITEM",
+        4,
+        "REPRESENTATION_RELATIONSHIP",
+    ),
+    ("POINT_STYLE", 1, "PRE_DEFINED_MARKER"),
+    ("CC_DESIGN_APPROVAL", 1, "CC_DESIGN_SECURITY_CLASSIFICATION"),
+    (
+        "SHAPE_ASPECT_RELATIONSHIP",
+        3,
+        "DIMENSIONAL_SIZE_WITH_DATUM_FEATURE",
+    ),
+    (
+        "MECHANICAL_DESIGN_AND_DRAUGHTING_RELATIONSHIP",
+        3,
+        "TESSELLATED_SHAPE_REPRESENTATION",
+    ),
+    ("DRAUGHTING_CALLOUT", 1, "ANNOTATION_PLACEHOLDER_OCCURRENCE"),
+    ("PRESENTATION_LAYER_ASSIGNMENT", 2, "PRODUCT"),
+    ("ADVANCED_FACE", 2, "AXIS2_PLACEMENT_3D"),
+];
+
+/// A reference whose target must have one of these record names (or a name with
+/// one of these suffixes): topology OCCT types strictly.
+const TYPED: [(&str, usize, &[&str]); 5] = [
+    ("FACE_BOUND", 1, &["_LOOP"]),
+    ("FACE_OUTER_BOUND", 1, &["_LOOP"]),
+    ("VECTOR", 1, &["DIRECTION"]),
+    ("CLOSED_SHELL", 1, &["FACE", "FACE_SURFACE"]),
+    ("OPEN_SHELL", 1, &["FACE", "FACE_SURFACE"]),
+];
+
+fn refs(p: &Param) -> Vec<u64> {
+    match p {
+        Param::Ref(id) => vec![*id],
+        Param::List(items) => items.iter().flat_map(refs).collect(),
+        Param::Typed(_, v) => refs(v),
+        _ => Vec::new(),
+    }
+}
+
+fn has_record(file: &StepFile, id: u64, name: &str) -> bool {
+    file.entities
+        .get(&id)
+        .is_some_and(|i| i.record(name).is_some())
+}
+
+fn names(inst: &Instance) -> Vec<&str> {
+    match inst {
+        Instance::Simple(r) => vec![r.name.as_str()],
+        Instance::Complex(rs) => rs.iter().map(|r| r.name.as_str()).collect(),
+    }
+}
+
+fn entity(file: &StepFile, id: u64, inst: &Instance, out: &mut Vec<Finding>) {
+    let mut push = |message: String| out.push(Finding::new(Class::Schema, Some(id), message));
+    let (records, complex): (&[Record], bool) = match inst {
+        Instance::Simple(r) => (std::slice::from_ref(r), false),
+        Instance::Complex(rs) => {
+            // Part 21 writes a complex instance's records in alphabetical order;
+            // OCCT reads them by position.
+            if rs
+                .windows(2)
+                .any(|w| matches!(w, [a, b] if a.name > b.name))
+            {
+                push(format!(
+                    "complex instance #{id} is not in alphabetical order"
+                ));
+            }
+            // A conversion-based unit's dimensions must be an entity, not derived.
+            if inst.record("CONVERSION_BASED_UNIT").is_some() {
+                if let Some(nu) = inst.record("NAMED_UNIT") {
+                    if !matches!(nu.params.first(), Some(Param::Ref(_))) {
+                        push(format!(
+                            "conversion-based unit #{id} dimensions not an entity"
+                        ));
+                    }
+                }
+            }
+            (rs.as_slice(), true)
+        }
+    };
+    for r in records {
+        let name = r.name.as_str();
+        if !complex {
+            if let Some(&(_, n)) = COUNTS.iter().find(|(e, _)| *e == name) {
+                if r.params.len() != n {
+                    push(format!("{name} has {} parameters, not {n}", r.params.len()));
+                    continue;
+                }
+            }
+            if name == "GEOMETRIC_REPRESENTATION_CONTEXT"
+                && !matches!(r.params.first(), Some(Param::Str(_)))
+            {
+                push(format!("{name} context identifier is not a string"));
+            }
+            if LABELLED.contains(&name) && matches!(r.params.first(), Some(Param::Null)) {
+                push(format!("{name} name is not a string"));
+            }
+        } else if let Some(&(_, n)) = COMPLEX_COUNTS.iter().find(|(e, _)| *e == name) {
+            if r.params.len() != n {
+                push(format!("{name} has {} parameters, not {n}", r.params.len()));
+                continue;
+            }
+        }
+        if let Some(&(_, simple, part)) = ENUMS.iter().find(|(e, ..)| *e == name) {
+            let i = if complex { part } else { simple };
+            if matches!(r.params.get(i), Some(Param::Null)) {
+                push(format!("{name} parameter {} is not an enumeration", i + 1));
+            }
+        }
+        if let Some(&(_, i)) = LISTS.iter().find(|(e, _)| *e == name) {
+            if !matches!(r.params.get(i), Some(Param::List(_))) {
+                push(format!("{name} parameter {} is not a list", i + 1));
+            }
+        }
+        if let Some(&(_, i)) = REFS.iter().find(|(e, _)| *e == name) {
+            if matches!(
+                r.params.get(i),
+                Some(Param::Null | Param::List(_) | Param::Typed(..))
+            ) {
+                push(format!("{name} parameter {} is not an entity", i + 1));
+            }
+        }
+        for &(_, i, bad) in ILLEGAL.iter().filter(|(e, ..)| *e == name) {
+            if let Some(p) = r.params.get(i) {
+                if refs(p).into_iter().any(|t| has_record(file, t, bad)) {
+                    push(format!("{name} parameter {} refers to {bad}", i + 1));
+                }
+            }
+        }
+        if !complex {
+            for &(_, i, want) in TYPED.iter().filter(|(e, ..)| *e == name) {
+                let Some(p) = r.params.get(i) else { continue };
+                for t in refs(p) {
+                    let Some(target) = file.entities.get(&t) else {
+                        continue;
+                    };
+                    let ok = names(target).iter().any(|n| {
+                        want.iter().any(|w| {
+                            if let Some(suffix) = w.strip_prefix('_') {
+                                n.ends_with(suffix)
+                            } else {
+                                n == w || n.ends_with(&format!("_{w}"))
+                            }
+                        })
+                    });
+                    if !ok {
+                        push(format!(
+                            "{name} parameter {} refers to {}",
+                            i + 1,
+                            target.type_name()
+                        ));
+                        break;
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// External references, as `STEPConstruct_ExternRefs` finds them: a product
+/// definition with associated documents, or a document reference to a document
+/// file.
+fn external_references(file: &StepFile, out: &mut Vec<Finding>) {
+    for (&id, inst) in &file.entities {
+        if inst
+            .record("PRODUCT_DEFINITION_WITH_ASSOCIATED_DOCUMENTS")
+            .is_some()
+        {
+            out.push(Finding::new(
+                Class::ExternalReference,
+                Some(id),
+                "product definition with associated documents",
+            ));
+        } else if let Some(r) = inst.record("APPLIED_DOCUMENT_REFERENCE") {
+            if r.params
+                .first()
+                .and_then(Param::as_ref_id)
+                .is_some_and(|d| has_record(file, d, "DOCUMENT_FILE"))
+            {
+                out.push(Finding::new(
+                    Class::ExternalReference,
+                    Some(id),
+                    "document reference to a document file",
+                ));
+            }
+        }
+    }
+}
