     assert_eq!(stitched.path, BuildPath::Stitch);
 }
 
+/// `repaired` reports a topology build that is not the file's topology as written: a
+/// clean cube built as written is not repaired, the same cube healed is (the flag is
+/// set after the healer runs), and a stitched build is never a repaired topology one.
+#[test]
+fn the_repaired_flag_reports_healed_and_repaired_topology_builds() {
+    let built = build_body(&cube(), options(false)).unwrap();
+    assert_eq!(built.path, BuildPath::Topology);
+    assert!(!built.repaired);
+    let healed = build_body(
+        &cube(),
+        BuildOptions {
+            heal: true,
+            ..options(false)
+        },
+    )
+    .unwrap();
+    assert_eq!(healed.path, BuildPath::Topology);
+    assert!(healed.repaired);
+    let stitched = build_body(&cube(), options(true)).unwrap();
+    assert_eq!(stitched.path, BuildPath::Stitch);
+    assert!(!stitched.repaired);
+}
