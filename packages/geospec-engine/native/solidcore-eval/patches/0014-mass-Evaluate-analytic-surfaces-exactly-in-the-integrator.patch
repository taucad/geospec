+/// A surface of revolution's net evaluated in its exact separable form, for
+/// [`RevolutionNet::first_derivs_at_u`].
+///
+/// A NURB made by sweeping a generator about an axis (`create_surf_of_revolution`:
+/// cones, cylinders, spheres, tori and other surfaces of revolution) has
+/// `Pw[i][j] = wc_i wg_j (O + ga_j a + gr_j (cx_i e1 + cy_i e2))` (sweep index `i`,
+/// generator index `j`), so the rational surface is exactly
+/// `S = O + ga(t) a + gr(t) (cx(s) e1 + cy(s) e2)`, with `(cx, cy)` the sweep's
+/// rational unit circle and `(ga, gr)` the generator's rational profile: two
+/// one-dimensional rational curves instead of the bivariate rational basis. The
+/// derivatives follow from the product rule. [`RevolutionNet::new`] reads the two
+/// curves off the net and accepts the net only when every control point and weight
+/// rebuilt from them matches the stored one to `1e-12` relative, so the surface it
+/// evaluates is the NURB's to that relative size (both have the same knots and
+/// positive weights). The results agree with [`Surface::first_derivs_into`] to
+/// round-off, not bit for bit.
+#[derive(Debug)]
+pub struct RevolutionNet<'a> {
+    sur: &'a Surface,
+    /// Whether the sweep (circle) runs along the net's u.
+    sweep_in_u: bool,
+    origin: Vec3,
+    axis: Vec3,
+    e1: Vec3,
+    e2: Vec3,
+    /// Homogeneous `(w cx, w cy, w)` of the sweep circle.
+    circle: Vec<[f64; 3]>,
+    /// Homogeneous `(w ga, w gr, w)` of the generator profile.
+    profile: Vec<[f64; 3]>,
+}
+
+/// A one-dimensional rational curve's point and first derivative.
+#[derive(Debug, Clone, Copy)]
+struct Curve2 {
+    p: [f64; 2],
+    d: [f64; 2],
+}
+
+/// The relative size within which a rebuilt control point must match the net.
+const REV_TOL: f64 = 1e-12;
+
+impl<'a> RevolutionNet<'a> {
+    /// The separable form of `sur`, swept about the axis through `origin` along
+    /// `axis` (unit), with the sweep along u when `sweep_in_u`; `None` when the net is
+    /// not, to [`REV_TOL`], that of a surface of revolution about this axis (or is
+    /// not rational, is planar in storage, or has a non-positive weight).
+    #[must_use]
+    #[allow(clippy::similar_names, clippy::many_single_char_names)]
+    pub fn new(sur: &'a Surface, origin: Vec3, axis: Vec3, sweep_in_u: bool) -> Option<Self> {
+        let (n, m, _, _) = sur.array_sizes();
+        let (pu, qu) = sur.degrees();
+        if pu > MAX_DEGREE || qu > MAX_DEGREE {
+            return None;
+        }
+        let p00 = sur.cpt(0, 0).ok()?;
+        if p00.w == NOW || p00.z == NOZ {
+            return None;
+        }
+        let (nc, ng) = if sweep_in_u { (n, m) } else { (m, n) };
+        let at = |c: usize, g: usize| -> Option<(Vec3, f64)> {
+            let pw = if sweep_in_u {
+                sur.cpt(c, g).ok()?
+            } else {
+                sur.cpt(g, c).ok()?
+            };
+            if !(pw.w.is_finite() && pw.w > 0.0) {
+                return None;
+            }
+            Some((Vec3::new(pw.x / pw.w, pw.y / pw.w, pw.z / pw.w), pw.w))
+        };
+        let len = axis.length();
+        if !(len.is_finite() && (len - 1.0).abs() < 1e-12) {
+            return None;
+        }
+        // The generator: its first sweep row.
+        let mut first = Vec::with_capacity(ng + 1);
+        let mut scale = 0.0_f64;
+        let mut best: Option<(usize, f64)> = None;
+        for g in 0..=ng {
+            let (pt, w) = at(0, g)?;
+            let d = pt - origin;
+            let ga = d.dot(axis);
+            let radial = d - ga * axis;
+            let r = radial.length();
+            scale = scale.max(d.length());
+            if best.is_none_or(|(_, b)| r > b) {
+                best = Some((g, r));
+            }
+            first.push((ga, radial, w));
+        }
+        let (gs, rs) = best?;
+        if !(rs.is_finite() && rs > 0.0) {
+            return None;
+        }
+        let (_, radial_s, ws) = *first.get(gs)?;
+        let e1 = radial_s / rs;
+        let e2 = axis.cross(e1);
+        let profile: Vec<[f64; 3]> = first
+            .iter()
+            .map(|&(ga, radial, w)| [w * ga, w * radial.dot(e1), w])
+            .collect();
+        let mut circle = Vec::with_capacity(nc + 1);
+        for c in 0..=nc {
+            let (pt, w) = at(c, gs)?;
+            let d = pt - origin;
+            let wc = w / ws;
+            let gr = rs;
+            circle.push([wc * (d.dot(e1) / gr), wc * (d.dot(e2) / gr), wc]);
+        }
+        // Every control point and weight, rebuilt.
+        let tol = REV_TOL * scale.max(f64::MIN_POSITIVE);
+        for (c, cw) in circle.iter().enumerate() {
+            let (cx, cy) = (cw[0] / cw[2], cw[1] / cw[2]);
+            for (g, gw) in profile.iter().enumerate() {
+                let (pt, w) = at(c, g)?;
+                let (ga, gr) = (gw[0] / gw[2], gw[1] / gw[2]);
+                let rebuilt = origin + ga * axis + gr * (cx * e1 + cy * e2);
+                let weight = cw[2] * gw[2];
+                if !((rebuilt - pt).length() <= tol && (weight - w).abs() <= REV_TOL * w) {
+                    return None;
+                }
+            }
+        }
+        Some(Self {
+            sur,
+            sweep_in_u,
+            origin,
+            axis,
+            e1,
+            e2,
+            circle,
+            profile,
+        })
+    }
+
+    /// Where the sweep runs along u and the generator is a straight segment (degree 1,
+    /// equal weights to [`REV_TOL`]) over the v span holding `[lo, hi]`, with a radius
+    /// of one sign on `[lo, hi]` (cylinders and cones), `S(u, v)` is affine in `v`
+    /// there and `S_u` is affine in `v` along a fixed direction: returns
+    /// `(S(u, m), S_u(u, m), dS_u/dv, S_v)` at `u` (side `ufl`) and the midpoint `m`
+    /// of `[lo, hi]`; `None` otherwise.
+    #[must_use]
+    pub fn linear_in_v(
+        &self,
+        u: f64,
+        ufl: Side,
+        lo: f64,
+        hi: f64,
+    ) -> Option<(Vec3, Vec3, Vec3, Vec3)> {
+        let (n, m, r, s) = self.sur.array_sizes();
+        let (pu, qv) = self.sur.degrees();
+        if !self.sweep_in_u || qv != 1 {
+            return None;
+        }
+        let vk = self.sur.v_knots();
+        let mid = 0.5 * (lo + hi);
+        let k = KnotVector::new(vk, s)
+            .ok()?
+            .find_span(qv, mid, Side::Left)
+            .ok()?;
+        if k < 1 || k > m {
+            return None;
+        }
+        let (k0, k1) = (*vk.get(k)?, *vk.get(k + 1)?);
+        let (a, b) = (lo.min(hi), lo.max(hi));
+        if !(k0 <= a && b <= k1 && k1 > k0) {
+            return None;
+        }
+        let (p0, p1) = (self.profile.get(k - 1)?, self.profile.get(k)?);
+        if (p0[2] - p1[2]).abs() > REV_TOL * p0[2] {
+            return None;
+        }
+        let (ga0, gr0) = (p0[0] / p0[2], p0[1] / p0[2]);
+        let (ga1, gr1) = (p1[0] / p1[2], p1[1] / p1[2]);
+        let dga = (ga1 - ga0) / (k1 - k0);
+        let dgr = (gr1 - gr0) / (k1 - k0);
+        let (gr_a, gr_b) = (gr0 + (a - k0) * dgr, gr0 + (b - k0) * dgr);
+        if !(gr_a * gr_b > 0.0) {
+            return None;
+        }
+        let c = curve_at(self.sur.u_knots(), r, pu, n, &self.circle, u, ufl)?;
+        let ga = ga0 + (mid - k0) * dga;
+        let gr = gr0 + (mid - k0) * dgr;
+        let radial = c.p[0] * self.e1 + c.p[1] * self.e2;
+        let dradial = c.d[0] * self.e1 + c.d[1] * self.e2;
+        let point = self.origin + ga * self.axis + gr * radial;
+        let sv = dga * self.axis + dgr * radial;
+        let out = (point, gr * dradial, dgr * dradial, sv);
+        [out.0, out.1, out.2, out.3]
+            .iter()
+            .all(|v| v.x.is_finite() && v.y.is_finite() && v.z.is_finite())
+            .then_some(out)
+    }
+
+    /// For each `vs[i]` (side `vsides[i]`) at `u` (side `ufl`), the first derivative
+    /// block `[[S, S_v], [S_u, 0]]` into `sd[i]` with `done[i] = true` (as
+    /// [`FirstDerivsNet::first_derivs_at_u`], to round-off); `done[i] = false` where
+    /// a span or a weight sum is out of range (the caller evaluates that `v` with
+    /// [`Surface::first_derivs_into`]).
+    pub fn first_derivs_at_u(
+        &self,
+        u: f64,
+        ufl: Side,
+        vs: &[f64],
+        vsides: &[Side],
+        sd: &mut [[[Vec3; 2]; 2]],
+        done: &mut [bool],
+    ) {
+        for d in done.iter_mut() {
+            *d = false;
+        }
+        let (n, m, r, s) = self.sur.array_sizes();
+        let (pu, qv) = self.sur.degrees();
+        let (u_pts, v_pts) = if self.sweep_in_u {
+            (&self.circle, &self.profile)
+        } else {
+            (&self.profile, &self.circle)
+        };
+        let Some(cu) = curve_at(self.sur.u_knots(), r, pu, n, u_pts, u, ufl) else {
+            return;
+        };
+        for (((&v, &side), o), d) in vs
+            .iter()
+            .zip(vsides)
+            .zip(sd.iter_mut())
+            .zip(done.iter_mut())
+        {
+            let Some(cv) = curve_at(self.sur.v_knots(), s, qv, m, v_pts, v, side) else {
+                continue;
+            };
+            let (circ, prof, circ_is_u) = if self.sweep_in_u {
+                (cu, cv, true)
+            } else {
+                (cv, cu, false)
+            };
+            let [ga, gr] = prof.p;
+            let [dga, dgr] = prof.d;
+            let radial = circ.p[0] * self.e1 + circ.p[1] * self.e2;
+            let dradial = circ.d[0] * self.e1 + circ.d[1] * self.e2;
+            let point = self.origin + ga * self.axis + gr * radial;
+            let d_sweep = gr * dradial;
+            let d_gen = dga * self.axis + dgr * radial;
+            let (su, sv) = if circ_is_u {
+                (d_sweep, d_gen)
+            } else {
+                (d_gen, d_sweep)
+            };
+            *o = [[point, sv], [su, Vec3::ZERO]];
+            *d = true;
+        }
+    }
+}
+
+/// The point and first derivative at `t` (side `side`) of the one-dimensional
+/// rational curve with homogeneous control points `pts` (`last + 1` of them) on
+/// `knots` (`r + 1`) of degree `deg`: the span and basis of `univariate_derivs`.
+fn curve_at(
+    knots: &[f64],
+    r: usize,
+    deg: usize,
+    last: usize,
+    pts: &[[f64; 3]],
+    t: f64,
+    side: Side,
+) -> Option<Curve2> {
+    if deg < TINY_NP {
+        curve_at_n::<TINY_NP>(knots, r, deg, last, pts, t, side)
+    } else if deg < SMALL_NP {
+        curve_at_n::<SMALL_NP>(knots, r, deg, last, pts, t, side)
+    } else {
+        curve_at_n::<NP>(knots, r, deg, last, pts, t, side)
+    }
+}
+
+fn curve_at_n<const N: usize>(
+    knots: &[f64],
+    r: usize,
+    deg: usize,
+    last: usize,
+    pts: &[[f64; 3]],
+    t: f64,
+    side: Side,
+) -> Option<Curve2> {
+    let mut du: Derivatives<N> = [[0.0; N]; MAX_DERIVATIVE + 1];
+    let k = univariate_derivs::<N>(knots, r, deg, t, side, 1, &mut du, BD_OP).ok()?;
+    let k = usize::try_from(k).ok()?;
+    if k < deg || k > last {
+        return None;
+    }
+    let [d0, d1, ..] = &du;
+    let span = pts.get(k - deg..=k)?;
+    let (mut a, mut b) = ([0.0; 3], [0.0; 3]);
+    for ((pw, &n0), &n1) in span.iter().zip(d0.iter()).zip(d1.iter()) {
+        for ((ai, bi), &x) in a.iter_mut().zip(b.iter_mut()).zip(pw) {
+            *ai += n0 * x;
+            *bi += n1 * x;
+        }
+    }
+    let w = a[2];
+    if !(w.is_finite() && w > 0.0) {
+        return None;
+    }
+    let p = [a[0] / w, a[1] / w];
+    let d = [(b[0] - b[2] * p[0]) / w, (b[1] - b[2] * p[1]) / w];
+    if !(p.iter().chain(&d).all(|x| x.is_finite())) {
+        return None;
+    }
+    Some(Curve2 { p, d })
+}
