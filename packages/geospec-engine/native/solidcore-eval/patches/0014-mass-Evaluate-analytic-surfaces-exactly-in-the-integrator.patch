+/// A plane's inner (iso-u) integrals in closed form. On a plane
+/// `S = O + u su X + v sv Y` the integrand of [`OdeIsoCurveLength`] at fixed u is a
+/// polynomial in v: the area element `|S_u x S_v|` is constant, the volume element
+/// `c z(v)` linear (`c` the area element times the unit normal's z) and the volume
+/// moments `c x z`, `c y z` and `c z^2 / 2` quadratic, so [`ruled_integral`]'s
+/// three-point rule is exact over `[lo, hi]`. Gauss-Kronrod integrates the same
+/// polynomials exactly; the two differ by round-off only. Cylinders and cones swept
+/// along u with a straight generator are polynomial in v the same way
+/// ([`IsoFirstDerivs::linear_v_piece`]).
+#[derive(Debug, Clone, Copy)]
+struct PlaneInner {
+    origin: Point3,
+    su: Vec3,
+    sv: Vec3,
+    domain: crate::geom::extent2d::Extent2d,
+    clamps: bool,
+}
+
+impl PlaneInner {
+    /// The closed form for `surface` when it is a plane its evaluation reaches (the
+    /// same evaluation-depth check), relative to `origin`.
+    fn new(surface: &Surface, origin: Point3) -> Option<Self> {
+        let crate::surface::surface::SurfaceKind::Plane(plane) = surface.kind() else {
+            return None;
+        };
+        surface.check_evaluation_copy_depth(0).ok()?;
+        let pos = plane.position();
+        let scale = plane.uv_scale();
+        let su = pos.x_axis() * scale.x;
+        let sv = pos.y_axis() * scale.y;
+        Some(Self {
+            origin: pos.origin() - origin,
+            su,
+            sv,
+            domain: plane.step_uv_domain(),
+            clamps: !plane.is_out_of_bounds_enabled(),
+        })
+    }
+
+    /// `[area, volume, Mx, My, Mz]` integrated over `v` in `[lo, hi]` at `u`; `None`
+    /// when the plane's evaluation would clamp a point of that segment (it is then
+    /// integrated as usual).
+    fn integral(&self, u: f64, lo: f64, hi: f64) -> Option<V> {
+        use crate::geom::vector2d::Point2;
+        if self.clamps
+            && !(self.domain.contains_point(Point2::new(u, lo), 0.0)
+                && self.domain.contains_point(Point2::new(u, hi), 0.0))
+        {
+            return None;
+        }
+        let m = 0.5 * (lo + hi);
+        let pm = self.origin + u * self.su + m * self.sv;
+        ruled_integral(pm, self.su, Vec3::ZERO, self.sv, hi - lo)
+    }
+}
+
+/// The integrand of [`OdeIsoCurveLength`] integrated over a v segment of length `l`
+/// where the surface is affine in v, `S(m + t) - origin = pm + t sv`, and `S_u` is
+/// affine in v along a fixed direction, `S_u(m + t) = su + t dsu` with `dsu`
+/// parallel to `su` or zero (planes and cylinders: `dsu = 0`; cones: the radius
+/// varies linearly), `m` the segment's midpoint. The normal `S_u x S_v` then keeps
+/// its direction and its length is linear, so the area element is linear, the
+/// volume element quadratic and the volume moments cubic in v: three-point
+/// Gauss-Legendre integrates them exactly. `None` where the normal's length
+/// reaches the integrand's `EFF_ZERO` guard or turns over within the segment (it is
+/// then integrated adaptively as usual). See [`PlaneInner`].
+fn ruled_integral(pm: Vec3, su: Vec3, dsu: Vec3, sv: Vec3, l: f64) -> Option<V> {
+    let h = 0.5 * l;
+    let n_lo = (su - h * dsu).cross(sv);
+    let n_hi = (su + h * dsu).cross(sv);
+    if !(n_lo.length_squared() > crate::math::EFF_ZERO_SQ
+        && n_hi.length_squared() > crate::math::EFF_ZERO_SQ
+        && n_lo.dot(n_hi) > 0.0)
+    {
+        return None;
+    }
+    let r = (0.6_f64).sqrt() * h;
+    let mut out = [0.0; N];
+    for (t, w) in [(-r, 5.0 / 9.0), (0.0, 8.0 / 9.0), (r, 5.0 / 9.0)] {
+        // As the integrand: the normal, its length and the unitised normal's z.
+        let p = pm + t * sv;
+        let norm = (su + t * dsu).cross(sv);
+        let area = norm.length();
+        let unit = norm.unitize().ok()?;
+        let vol = area * p.z * unit.z;
+        let y = [area, vol, p.x * vol, p.y * vol, p.z * vol / 2.0];
+        for (o, yi) in out.iter_mut().zip(y) {
+            *o += w * yi;
+        }
+    }
+    for o in &mut out {
+        *o *= h;
+    }
+    out.iter().all(|x| x.is_finite()).then_some(out)
+}
