+
+/// `text` with every `=SHORT(` of [`ALIASES`] replaced by `=LONG(`, in one pass.
+///
+/// The same text as replacing each alias in turn: a match holds one `=`, at its
+/// start, and its name holds none, so matches never overlap one another or a
+/// replacement, and a replacement never forms a new match.
+fn normalize_aliases(text: &str) -> std::borrow::Cow<'_, str> {
+    let b = text.as_bytes();
+    let mut out: Option<String> = None;
+    // Bytes of `text` before `copied` are already in `out`.
+    let mut copied = 0;
+    let mut at = 0;
+    while let Some(eq) = b.get(at..).and_then(|r| part21::find_byte(r, b'=')) {
+        let eq = at + eq;
+        let rest = b.get(eq + 1..).unwrap_or_default();
+        let hit = ALIASES.iter().find(|(short, _)| {
+            rest.starts_with(short.as_bytes()) && rest.get(short.len()) == Some(&b'(')
+        });
+        if let Some((short, long)) = hit {
+            let o = out.get_or_insert_with(|| String::with_capacity(text.len() + 64));
+            o.push_str(text.get(copied..=eq).unwrap_or_default());
+            o.push_str(long);
+            copied = eq + 1 + short.len();
+            at = copied;
+        } else {
+            at = eq + 1;
+        }
+    }
+    match out {
+        None => std::borrow::Cow::Borrowed(text),
+        Some(mut o) => {
+            o.push_str(text.get(copied..).unwrap_or_default());
+            std::borrow::Cow::Owned(o)
+        }
     }
