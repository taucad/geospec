@@ -0,0 +1,50 @@
+//! Times `import_threads` over a list of files and prints, per file, the import
+//! time, a hash of the whole model (or error) as `Debug` text, and the path.
+//!
+//! `cargo run --release -p step-import --example parse_bench -- <threads> <list> [reps]`
+
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::time::Instant;
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let threads: usize = args.next().and_then(|t| t.parse().ok()).unwrap_or(1);
+    let list = args.next().unwrap_or_default();
+    let reps: usize = args.next().and_then(|t| t.parse().ok()).unwrap_or(1);
+    let text = std::fs::read_to_string(&list).unwrap_or_default();
+    let mut total = 0.0;
+    for path in text.lines().filter(|l| !l.is_empty()) {
+        let bytes = std::fs::read(path).unwrap_or_default();
+        let mut best = f64::INFINITY;
+        let mut digest = 0;
+        for _ in 0..reps {
+            let t = Instant::now();
+            let r = step_import::import_threads(&bytes, &step_import::Limits::default(), threads);
+            best = best.min(t.elapsed().as_secs_f64() * 1e3);
+            let mut h = DefaultHasher::new();
+            format!("{r:?}").hash(&mut h);
+            digest = h.finish();
+        }
+        total += best;
+        // Phase split: text and aliases, Part 21 parse, map, drop of the parse.
+        let lim = step_import::Limits::default();
+        let t = Instant::now();
+        let text = String::from_utf8_lossy(&bytes).into_owned();
+        let t_text = t.elapsed().as_secs_f64() * 1e3;
+        let t = Instant::now();
+        let file = step_import::part21::parse_threads(text.as_bytes(), &lim, threads);
+        let t_parse = t.elapsed().as_secs_f64() * 1e3;
+        let t = Instant::now();
+        let m = file
+            .as_ref()
+            .ok()
+            .map(|f| step_import::map::map_file_threads(f, &lim, threads));
+        let t_map = t.elapsed().as_secs_f64() * 1e3;
+        let t = Instant::now();
+        drop(file);
+        let t_drop = t.elapsed().as_secs_f64() * 1e3;
+        drop(m);
+        println!("{best:.2} {digest:016x} text {t_text:.1} parse {t_parse:.1} map {t_map:.1} drop {t_drop:.1} {path}");
+    }
+    eprintln!("total {total:.1} ms");
+}
