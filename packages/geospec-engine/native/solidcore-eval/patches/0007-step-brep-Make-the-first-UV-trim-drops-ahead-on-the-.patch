+/// [`trimming_tools::precompute_uv_trim_drops`] for the faces without UV trim curves;
+/// a failure only leaves the serial pass to do all the work.
+fn precompute_trim_drops(kernel: &Kernel, brep: &Brep, faces: &[FaceId], threads: usize) {
+    let missing: Vec<FaceId> = faces
+        .iter()
+        .copied()
+        .filter(|&f| !trimming_tools::face_uv_curves_present(brep, f).unwrap_or(true))
+        .collect();
+    let _ = trimming_tools::precompute_uv_trim_drops(kernel, brep, &missing, threads);
+}
