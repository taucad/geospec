+/// A drop of an edge use's curve onto its face's surface made ahead, on another thread
+/// (not upstream): [`create_uv_trim_curve`]'s first `DropCurve`, with the failure
+/// record it left. It is used only when the inputs the drop reads are the same, value
+/// for value, when the serial pass reaches the edge use ([`DropHint::key`]), so the pass
+/// gives what it gives without it.
+#[derive(Debug)]
+pub(crate) struct DropHint {
+    /// The identity of the face's surface value in the B-rep.
+    surface: std::sync::Arc<()>,
+    /// The identity of the edge's curve value in the B-rep.
+    curve: crate::curve::curve::p5::CurveEditToken,
+    /// The drop's other inputs.
+    key: DropHintKey,
+    /// The drop's result (`None` for a failed drop).
+    out: Option<DropCurveOut>,
+    /// The failure record after the drop.
+    fail: DropCurveFail<ObjectHandle>,
+}
+
+/// The inputs of the first drop of `create_uv_trim_curve` besides the surface and
+/// curve values (which [`DropHint`] holds by identity), bit for bit: the face domain,
+/// the curve's owner tolerance, the edge domain, the tolerance, the kernel state a drop
+/// reads, and the B-rep of the failure record (which is otherwise freshly reset before
+/// the drop).
+#[derive(Debug, Clone, PartialEq)]
+struct DropHintKey {
+    bits: [u64; 7],
+    owner_tol: Option<u64>,
+    kernel: crate::curve::curve::p5::CurveMemoKey,
+    brep: Option<ObjectHandle>,
+}
+
+fn drop_hint_key(
+    k: &Kernel,
+    face_domain: &crate::geom::extent2d::Extent2d,
+    curve: &Curve,
+    edge_domain: &Extent1d,
+    zone_tol: f64,
+    fail: &DropCurveFail<ObjectHandle>,
+) -> Option<DropHintKey> {
+    Some(DropHintKey {
+        bits: [
+            face_domain.min().x.to_bits(),
+            face_domain.min().y.to_bits(),
+            face_domain.max().x.to_bits(),
+            face_domain.max().y.to_bits(),
+            edge_domain.min().to_bits(),
+            edge_domain.max().to_bits(),
+            zone_tol.to_bits(),
+        ],
+        owner_tol: curve.owner_zone_tol_3d().map(f64::to_bits),
+        kernel: crate::curve::curve::p5::CurveMemoKey::of_kernel(k)?,
+        brep: fail.brep,
+    })
+}
+
+/// The identities of the face surface and edge curve values `eu`'s drop reads, in the
+/// B-rep.
+fn drop_identities(
+    b: &Brep,
+    eu: EdgeuseId,
+) -> Option<(std::sync::Arc<()>, crate::curve::curve::p5::CurveEditToken)> {
+    let e = edge(b, eu).ok().flatten()?;
+    let f = faceuse(b, eu)
+        .ok()
+        .flatten()
+        .and_then(|fu| faceuse_face(b, fu).ok().flatten())?;
+    let surface = b.face(f).ok()?.surface.as_ref()?.boundary_memo().identity();
+    let curve = b.edge(e).ok()?.curve.as_ref()?.edit_token();
+    Some((surface, curve))
+}
+
+/// The surface, face domain, edge curve, edge domain and tolerance of
+/// `create_uv_trim_curve`'s first drop for `eu`, as it builds them; `None` for an edge
+/// use it does not drop for at once (an edge on a curve on a surface).
+#[allow(clippy::type_complexity)]
+fn first_drop_inputs(
+    b: &Brep,
+    eu: EdgeuseId,
+) -> Result<
+    Option<(
+        Surface,
+        crate::geom::extent2d::Extent2d,
+        Curve,
+        Extent1d,
+        f64,
+    )>,
+> {
+    let Some(e) = edge(b, eu)? else {
+        return Ok(None);
+    };
+    let Some(fu) = faceuse(b, eu)? else {
+        return Ok(None);
+    };
+    let Some(f) = faceuse_face(b, fu)? else {
+        return Ok(None);
+    };
+    let face_rec = b.face(f)?;
+    let Some(surface) = face_rec.surface.as_ref() else {
+        return Ok(None);
+    };
+    let edge_rec = b.edge(e)?;
+    let Some(curve) = edge_rec.curve.as_ref() else {
+        return Ok(None);
+    };
+    if matches!(curve.kind(), CurveKind::CrvOnSurf(_)) {
+        return Ok(None);
+    }
+    let mut surface = surface.clone_for_evaluation()?;
+    let _ = surface.set_owner(None::<ObjectRef>);
+    let mut curve = curve.clone_for_evaluation()?;
+    curve.set_owner_zone_tol_3d(Some(edge_rec.tolerance));
+    Ok(Some((
+        surface,
+        face_rec.uv_domain,
+        curve,
+        edge_rec.interval,
+        edge_rec.tolerance,
+    )))
+}
+
+/// The [`DropHint`] of `eu` made on `k` (a kernel of its own, for another thread), or
+/// `None` when there is none to make or the drop must report an error itself.
+pub(crate) fn make_drop_hint(k: &Kernel, b: &Brep, eu: EdgeuseId) -> Option<DropHint> {
+    let (surface, face_domain, curve, edge_domain, zone_tol) =
+        first_drop_inputs(b, eu).ok().flatten()?;
+    let e = edge(b, eu).ok().flatten()?;
+    let f = faceuse(b, eu)
+        .ok()
+        .flatten()
+        .and_then(|fu| faceuse_face(b, fu).ok().flatten())?;
+    let mut fail = DropCurveFail::<ObjectHandle>::default();
+    fail.un_init();
+    fail.brep = brep_handle(b, eu).ok()?;
+    let (surface_id, curve_id) = drop_identities(b, eu)?;
+    let key = drop_hint_key(k, &face_domain, &curve, &edge_domain, zone_tol, &fail)?;
+    let out = status(surface_drop_curve(
+        k,
+        &surface,
+        &face_domain,
+        &curve,
+        &edge_domain,
+        zone_tol,
+        false,
+        Some(crate::intersect::surface_drop_lib::p1::DropFailRecord {
+            fail: &mut fail,
+            surface: Some(handle(ObjectKind::Surface, f.index())),
+            curve: Some(handle(ObjectKind::Curve, e.index())),
+        }),
+    ))
+    .ok()?;
+    Some(DropHint {
+        surface: surface_id,
+        curve: curve_id,
+        key,
+        out,
+        fail,
+    })
+}
+
+/// The edge uses of `faces` that have no UV trim curve, in the faces' order.
+fn edgeuses_without_trims(b: &Brep, faces: &[FaceId]) -> Result<Vec<EdgeuseId>> {
+    let mut out = Vec::new();
+    for &f in faces {
+        for eu in crate::topology::face::p4::upward_edgeuses(b, f, false, None)? {
+            if uv_trim_curve(b, eu)?.0.is_none() {
+                out.push(eu);
+            }
+        }
+    }
+    Ok(out)
+}
+
+/// Makes the first drops of the UV trim curves `faces` lack on `threads` threads, ahead
+/// of a serial pass that creates them, and leaves them on `k` (not upstream). Each
+/// thread has a kernel of its own with `k`'s tolerances and fixes; a drop is used only
+/// when its inputs and that kernel state are still the same, so the serial pass gives
+/// the same result with or without them.
+///
+/// # Errors
+///
+/// Those of the topology walk.
+pub fn precompute_uv_trim_drops(
+    k: &Kernel,
+    b: &Brep,
+    faces: &[FaceId],
+    threads: usize,
+) -> Result<()> {
+    if threads < 2 || CurveMemoKeyCheck::of(k).is_none() {
+        return Ok(());
+    }
+    let tasks = edgeuses_without_trims(b, faces)?;
+    if tasks.len() < 2 {
+        return Ok(());
+    }
+    let next = std::sync::atomic::AtomicUsize::new(0);
+    // (each thread's kernel is a copy of `k`'s settings and context scalars, as the
+    // merge's cache kernels are)
+    let kernels: Vec<Kernel> = (0..threads.min(tasks.len()))
+        .map(|_| crate::boolean::merge::p4::kernel_adapter::cache_kernel(k, &k.context))
+        .collect();
+    let mut found: Vec<(u32, DropHint)> = std::thread::scope(|scope| {
+        let workers: Vec<_> = kernels
+            .into_iter()
+            .map(|wk| {
+                let (next, tasks) = (&next, &tasks);
+                scope.spawn(move || {
+                    let mut mine = Vec::new();
+                    loop {
+                        let i = next.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                        let Some(&eu) = tasks.get(i) else { break };
+                        if let Some(h) = make_drop_hint(&wk, b, eu) {
+                            mine.push((eu.index(), h));
+                        }
+                    }
+                    mine
+                })
+            })
+            .collect();
+        workers
+            .into_iter()
+            .flat_map(|w| w.join().unwrap_or_default())
+            .collect()
+    });
+    found.sort_by_key(|(i, _)| *i);
+    let mut hints = k.drop_hints.borrow_mut();
+    for (i, h) in found {
+        hints.insert(i, h);
+    }
+    Ok(())
+}
+
+/// Whether `k` has the kernel state a [`DropHint`] key records.
+struct CurveMemoKeyCheck;
+
+impl CurveMemoKeyCheck {
+    fn of(k: &Kernel) -> Option<()> {
+        crate::curve::curve::p5::CurveMemoKey::of_kernel(k).map(|_| ())
+    }
+}
+
+/// The [`DropHint`] left for `eu`, when the surface and curve values are the same and
+/// its key is `key`; any hint for `eu` is used up.
+fn take_drop_hint(k: &Kernel, b: &Brep, eu: EdgeuseId, key: &DropHintKey) -> Option<DropHint> {
+    let hint = k.drop_hints.borrow_mut().remove(&eu.index())?;
+    let (surface, curve) = drop_identities(b, eu)?;
+    let same = std::sync::Arc::ptr_eq(&hint.surface, &surface)
+        && hint
+            .curve
+            .matches(b.edge(edge(b, eu).ok().flatten()?).ok()?.curve.as_ref()?)
+        && hint.key == *key;
+    drop(curve);
+    same.then_some(hint)
+}
+
