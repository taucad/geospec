new file mode 100644
index 000000000..2ba5a8826
--- /dev/null
+++ b/crates/solidcore/src/nurbs/srf_nurb/batch.rs
@@ -0,0 +1,421 @@
+//! First derivatives at many `v` along one iso-`u` line, several `v` at a time.
+//!
+//! [`FirstDerivsNet::first_derivs_at_u`] gives, for each `v`, exactly the bits
+//! [`Surface::first_derivs_into`] gives with `udr = vdr = 1` and the upper half
+//! (`upper = true`). It does the same IEEE operations in the same order, only
+//! shared or spread across lanes:
+//!
+//! - the u-direction span and basis derivatives are computed once per call, by the
+//!   same `univariate_derivs` the scalar path runs for every `v` (a pure function of
+//!   the knots, `u` and the side, so the same values);
+//! - the Euclidean control points (`to_euclid_spec` of each `Pw`) are converted once
+//!   per net row and kept, instead of once per call;
+//! - the `v` basis, the rational basis derivatives and the derivative sums run
+//!   [`LANES`] values of `v` at a time that share a `v` span. Every lane performs
+//!   the scalar code's sequence of separate multiplies, adds, subtracts and divides
+//!   (Rust never contracts them into fused multiply-adds, and no sum is
+//!   reassociated: the interleaved accumulators are independent, each summed in the
+//!   scalar order).
+//!
+//! A `v` the batch cannot reproduce with certainty (a span that differs within its
+//! group of lanes, an index outside the net or the knots, a denominator the scalar
+//! code refuses) is reported as not done, and the caller evaluates it with
+//! [`Surface::first_derivs_into`], which then gives the scalar result or error.
+
+use std::cell::OnceCell;
+
+use super::{to_euclid_spec, univariate_derivs, Derivatives, NP, SMALL_NP, TINY_NP};
+use crate::math::Vec3;
+use crate::nurbs::knots::{KnotVector, Side, MAX_DEGREE};
+use crate::nurbs::math::{float_op_is_bad, pascal_entry, FloatOp, MAX_DERIVATIVE, NOW, NOZ};
+use crate::nurbs::srf_basic::Surface;
+
+/// Values of `v` evaluated together.
+pub const LANES: usize = 4;
+
+/// One value per lane.
+type L = [f64; LANES];
+
+const BD_OP: &str = "nurbs::srf_nurb::Surface::basis_derivs";
+
+#[inline(always)]
+fn splat(x: f64) -> L {
+    [x; LANES]
+}
+
+#[inline(always)]
+fn add(a: L, b: L) -> L {
+    let mut r = a;
+    for (x, y) in r.iter_mut().zip(b) {
+        *x += y;
+    }
+    r
+}
+
+#[inline(always)]
+fn sub(a: L, b: L) -> L {
+    let mut r = a;
+    for (x, y) in r.iter_mut().zip(b) {
+        *x -= y;
+    }
+    r
+}
+
+#[inline(always)]
+fn mul(a: L, b: L) -> L {
+    let mut r = a;
+    for (x, y) in r.iter_mut().zip(b) {
+        *x *= y;
+    }
+    r
+}
+
+#[inline(always)]
+fn div(a: L, b: L) -> L {
+    let mut r = a;
+    for (x, y) in r.iter_mut().zip(b) {
+        *x /= y;
+    }
+    r
+}
+
+/// `s * a` per lane (the scalar code's `s * a`, a scalar times a lane value).
+#[inline(always)]
+fn smul(s: f64, a: L) -> L {
+    let mut r = a;
+    for x in &mut r {
+        *x = s * *x;
+    }
+    r
+}
+
+/// `a * s` per lane.
+#[inline(always)]
+fn muls(a: L, s: f64) -> L {
+    let mut r = a;
+    for x in &mut r {
+        *x *= s;
+    }
+    r
+}
+
+/// A NURBS net prepared for [`FirstDerivsNet::first_derivs_at_u`]: the surface, its
+/// rationality and dimension flags (from `Pw[0][0]`, as the scalar path reads them),
+/// and the Euclidean control points, converted per row on first use.
+#[derive(Debug)]
+pub struct FirstDerivsNet<'a> {
+    sur: &'a Surface,
+    rational: bool,
+    no_w: bool,
+    no_z: bool,
+    rows: Vec<OnceCell<Box<[Vec3]>>>,
+}
+
+/// The u-direction part shared by every `v` of a call.
+struct UPart<const N: usize> {
+    du: Derivatives<N>,
+    /// The first net row of the span (`ku - p`).
+    s1: usize,
+}
+
+impl<'a> FirstDerivsNet<'a> {
+    /// `None` when the scalar path would not take its stack evaluation (a degree
+    /// above `NL_MAXDEG`) or cannot read `Pw[0][0]`: such a surface is always
+    /// evaluated by [`Surface::first_derivs_into`].
+    #[must_use]
+    pub fn new(sur: &'a Surface) -> Option<Self> {
+        let (pu, qu) = sur.degrees();
+        if pu > MAX_DEGREE || qu > MAX_DEGREE {
+            return None;
+        }
+        let p00 = sur.cpt(0, 0).ok()?;
+        let (n, _, _, _) = sur.array_sizes();
+        Some(Self {
+            sur,
+            rational: sur.is_rational(),
+            no_w: p00.w == NOW,
+            no_z: p00.z == NOZ,
+            rows: (0..=n).map(|_| OnceCell::new()).collect(),
+        })
+    }
+
+    /// The Euclidean points of net row `i` (`to_euclid_spec` of each `Pw[i][j]`).
+    fn euclid_row(&self, i: usize) -> Option<&[Vec3]> {
+        let cell = self.rows.get(i)?;
+        if let Some(r) = cell.get() {
+            return Some(r);
+        }
+        let row = self.sur.row(i).ok()?;
+        let conv: Box<[Vec3]> = row
+            .iter()
+            .map(|pw| to_euclid_spec(self.no_z, self.no_w, *pw))
+            .collect();
+        Some(cell.get_or_init(|| conv))
+    }
+
+    /// For each `vs[i]` (side `vsides[i]`) at `u` (side `ufl`), the first derivative
+    /// block of [`Surface::first_derivs_into`] with `upper = true` into `sd[i]`, with
+    /// `done[i] = true`; `done[i] = false` where the caller must evaluate that `v` with
+    /// [`Surface::first_derivs_into`] itself (`sd[i]` is then unspecified). The slices
+    /// have one entry per `v`; extra entries of the longer ones are left alone.
+    pub fn first_derivs_at_u(
+        &self,
+        u: f64,
+        ufl: Side,
+        vs: &[f64],
+        vsides: &[Side],
+        sd: &mut [[[Vec3; 2]; 2]],
+        done: &mut [bool],
+    ) {
+        for d in done.iter_mut() {
+            *d = false;
+        }
+        let (pu, qu) = self.sur.degrees();
+        if pu < TINY_NP && qu < TINY_NP {
+            self.at_u_n::<TINY_NP>(u, ufl, vs, vsides, sd, done);
+        } else if pu < SMALL_NP && qu < SMALL_NP {
+            self.at_u_n::<SMALL_NP>(u, ufl, vs, vsides, sd, done);
+        } else {
+            self.at_u_n::<NP>(u, ufl, vs, vsides, sd, done);
+        }
+    }
+
+    fn at_u_n<const N: usize>(
+        &self,
+        u: f64,
+        ufl: Side,
+        vs: &[f64],
+        vsides: &[Side],
+        sd: &mut [[[Vec3; 2]; 2]],
+        done: &mut [bool],
+    ) {
+        let Some(up) = self.u_part::<N>(u, ufl) else {
+            return;
+        };
+        let (_, qu) = self.sur.degrees();
+        let (_, m, _, s2u) = self.sur.array_sizes();
+        let Ok(vknots) = KnotVector::new(self.sur.v_knots(), s2u) else {
+            return;
+        };
+        let count = vs.len().min(vsides.len()).min(sd.len()).min(done.len());
+        let mut start = 0;
+        while start < count {
+            let end = (start + LANES).min(count);
+            // The v span of every lane of the group, as `univariate_derivs` finds it.
+            let mut kv = None;
+            let mut same = true;
+            for (v, side) in vs.iter().zip(vsides).take(end).skip(start) {
+                match vknots.find_span(qu, *v, *side) {
+                    Ok(k) if kv.is_none_or(|kv| kv == k) => kv = Some(k),
+                    _ => {
+                        same = false;
+                        break;
+                    }
+                }
+            }
+            if let (true, Some(kv)) = (same, kv) {
+                if kv >= qu && kv <= m {
+                    let mut t = splat(vs.get(start).copied().unwrap_or(0.0));
+                    for (lane, v) in t.iter_mut().zip(vs.iter().take(end).skip(start)) {
+                        *lane = *v;
+                    }
+                    if let Some(out) = self.lanes::<N>(&up, kv, t) {
+                        for ((o, d), r) in sd
+                            .iter_mut()
+                            .zip(done.iter_mut())
+                            .take(end)
+                            .skip(start)
+                            .zip(out)
+                        {
+                            *o = r;
+                            *d = true;
+                        }
+                    }
+                }
+            }
+            start = end;
+        }
+    }
+
+    /// `univariate_derivs` in u, once; `None` where the scalar path fails or the span
+    /// leaves the net.
+    fn u_part<const N: usize>(&self, u: f64, ufl: Side) -> Option<UPart<N>> {
+        let (pu, _) = self.sur.degrees();
+        let (n, _, s1u, _) = self.sur.array_sizes();
+        let mut du: Derivatives<N> = [[0.0; N]; MAX_DERIVATIVE + 1];
+        let ku =
+            univariate_derivs::<N>(self.sur.u_knots(), s1u, pu, u, ufl, 1, &mut du, BD_OP).ok()?;
+        let ku = usize::try_from(ku).ok()?;
+        if ku < pu || ku > n {
+            return None;
+        }
+        Some(UPart { du, s1: ku - pu })
+    }
+
+    /// The `v` basis of `univariate_derivs` (`dr = 1`) for each lane of `t`, all in
+    /// span `kv`: `[D0, D1]`, each `q + 1` wide.
+    fn v_basis<const N: usize>(&self, kv: usize, t: L) -> Option<[[L; N]; 2]> {
+        let (_, q) = self.sur.degrees();
+        let vk = self.sur.v_knots();
+        let z = splat(0.0);
+        // `N_ComputeBasisFunctions`: the triangular table `ndu`.
+        let mut ndu = [[z; N]; N];
+        let mut left = [z; N];
+        let mut right = [z; N];
+        *ndu.get_mut(0)?.get_mut(0)? = splat(1.0);
+        for j in 1..=q {
+            let kl = *vk.get((kv + 1).checked_sub(j)?)?;
+            let kr = *vk.get(kv + j)?;
+            *left.get_mut(j)? = sub(t, splat(kl));
+            *right.get_mut(j)? = sub(splat(kr), t);
