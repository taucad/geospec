+                for (dk, duk) in d.iter_mut().zip([du0, du1]) {
+                    let dkl = dk.get_mut(l)?;
+                    *dkl = z;
+                    for (tv, duki) in tu.iter().zip(duk.iter()).take(p + 1) {
