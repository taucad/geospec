+            for r in 0..j {
+                let rt = *right.get(r + 1)?;
+                let lt = *left.get(j - r)?;
+                let njr = add(rt, lt);
+                *ndu.get_mut(j)?.get_mut(r)? = njr;
+                let temp = div(*ndu.get(r)?.get(j - 1)?, njr);
+                *ndu.get_mut(r)?.get_mut(j)? = add(saved, mul(rt, temp));
+                saved = mul(lt, temp);
+            }
+            *ndu.get_mut(j)?.get_mut(j)? = saved;
+        }
+        let mut dv = [[z; N]; 2];
+        let [d0, d1] = &mut dv;
+        for (j, d) in d0.iter_mut().enumerate().take(q + 1) {
+            *d = *ndu.get(j)?.get(q)?;
+        }
+        // `N_ComputeDerivatives` with `mder = min(q, 1)`, then the factor `q`.
+        if q >= 1 {
+            let nq = ndu.get(q)?;
+            for (r, d) in d1.iter_mut().enumerate().take(q + 1) {
+                let mut dd = z;
+                if r >= 1 {
+                    let v = div(splat(1.0), *nq.get(r - 1)?);
