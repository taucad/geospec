+                }
+                *d = muls(dd, q as f64);
+            }
+        }
+        Some(dv)
+    }
+
+    /// The first derivative blocks of the lanes of `t` (one `v` span `kv`).
+    #[allow(clippy::similar_names)]
+    fn lanes<const N: usize>(
+        &self,
+        up: &UPart<N>,
+        kv: usize,
+        t: L,
+    ) -> Option<[[[Vec3; 2]; 2]; LANES]> {
+        let (p, q) = self.sur.degrees();
+        let [dv0, dv1] = self.v_basis::<N>(kv, t)?;
+        let [du0, du1, ..] = &up.du;
+        let s1 = up.s1;
+        let s2 = kv - q;
+        let z = splat(0.0);
+        let no_z = self.no_z;
+
+        // The span's control points: the weights from `Pw`, the Euclidean points
+        // from the converted rows.
+        let mut prow: [&[Vec3]; N] = [&[]; N];
+        let mut wrow: [&[crate::nurbs::math::CPoint]; N] = [&[]; N];
+        for (i, (pr, wr)) in prow.iter_mut().zip(wrow.iter_mut()).enumerate().take(p + 1) {
+            *pr = self.euclid_row(s1 + i)?.get(s2..=s2 + q)?;
+            *wr = self.sur.row(s1 + i).ok()?.get(s2..=s2 + q)?;
+        }
+
+        // `[S, Su, Sv]` sums, x y z each.
+        let mut s = [[z; 3]; 3];
+        let accumulate = |s: &mut [[L; 3]; 3], alpha: [L; 3], pt: Vec3| {
+            for (sk, a) in s.iter_mut().zip(alpha) {
+                let [sx, sy, sz] = sk;
+                *sx = add(*sx, mul(a, splat(pt.x)));
+                *sy = add(*sy, mul(a, splat(pt.y)));
+                if !no_z {
+                    *sz = add(*sz, mul(a, splat(pt.z)));
