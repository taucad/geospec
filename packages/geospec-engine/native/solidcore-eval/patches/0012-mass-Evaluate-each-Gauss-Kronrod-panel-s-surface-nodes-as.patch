+            {
+                return None;
+            }
+            let inv_w00 = div(splat(1.0), d00);
+            let t11 = pascal_entry(1, 1)?;
+            let c0_11 = smul(t11, d01);
+            let c1_11 = smul(t11, d10);
+            for (n, wr) in wrow.iter().enumerate().take(p + 1) {
+                let (du0n, du1n) = (*du0.get(n)?, *du1.get(n)?);
+                let pr = prow.get(n)?;
+                for (m, pw) in wr.iter().enumerate().take(q + 1) {
+                    let wnm = pw.w;
+                    let (dv0m, dv1m) = (*dv0.get(m)?, *dv1.get(m)?);
+                    // (k, l) = (0, 0)
+                    let v00 = smul(wnm * du0n, dv0m);
+                    let b00 = mul(v00, inv_w00);
+                    // (0, 1)
+                    let mut v01 = smul(wnm * du0n, dv1m);
+                    v01 = sub(v01, mul(c0_11, b00));
+                    let b01 = mul(v01, inv_w00);
+                    // (1, 0)
+                    let mut v10 = smul(wnm * du1n, dv0m);
+                    v10 = sub(v10, mul(c1_11, b00));
+                    v10 = sub(v10, smul(t11, z));
+                    let b10 = mul(v10, inv_w00);
+                    accumulate(&mut s, [b00, b01, b10], *pr.get(m)?);
+                }
+            }
+        } else {
+            for (n, pr) in prow.iter().enumerate().take(p + 1) {
+                let (du0n, du1n) = (*du0.get(n)?, *du1.get(n)?);
+                for (m, pt) in pr.iter().enumerate().take(q + 1) {
+                    let (dv0m, dv1m) = (*dv0.get(m)?, *dv1.get(m)?);
+                    let alpha = [smul(du0n, dv0m), smul(du0n, dv1m), smul(du1n, dv0m)];
+                    accumulate(&mut s, alpha, *pt);
+                }
+            }
+        }
+
+        let [s00, s01, s10] = s;
+        let mut out = [[[Vec3::ZERO; 2]; 2]; LANES];
+        for (lane, o) in out.iter_mut().enumerate() {
+            let v = |c: &[L; 3]| -> Option<Vec3> {
+                Some(Vec3::new(
+                    *c[0].get(lane)?,
+                    *c[1].get(lane)?,
+                    *c[2].get(lane)?,
+                ))
+            };
+            *o = [[v(&s00)?, v(&s01)?], [v(&s10)?, Vec3::ZERO]];
+        }
+        Some(out)
+    }
+}
